{
  "format": "godottrench-mcp-script",
  "vars": { "save_dir": "${project}/demo/maps/showcase" },
  "title": "Mountain Hanging House",
  "description": "A mountain with a cabin hanging off a cliff below a rock ledge, a furnished interior, a cliff lift, a respawn teleport and scattered forests. Built entirely from MCP tool calls.",
  "steps": [
    { "note": "Start from an empty map with the Godot demo project's materials and entities." },
    { "tool": "map_file", "args": { "op": "new" } },
    { "tool": "set_map_properties", "args": { "properties": {
      "message": "Mountain Hanging House",
      "sun_angles": "-38 -58", "sun_color": "255 238 210", "sun_energy": "1.2", "ambient_color": "70 82 104",
      "sky_top_color": "70 118 188", "sky_horizon_color": "188 206 222", "sky_ground_color": "96 102 108",
      "fog_color": "182 198 214", "fog_density": "0.00025"
    } } },

    { "note": "Terrain: a generated mountain, a flattened plateau for the anchors and a valley cut to the east, which leaves a cliff." },
    { "tool": "hierarchy", "args": { "op": "add_layer", "name": "Terrain" } },
    { "tool": "create_terrain", "args": {
      "origin": [-4096, 0, -4096], "resolution": 129, "cell_size": 64, "shape": "mountain", "height": 2900, "seed": 11,
      "feature_size": 2600, "erosion": 10, "auto_paint": false,
      "layers": [["showcase/grass", 384], ["showcase/cliff", 256], ["showcase/snow", 512], ["showcase/dirt", 256]]
    }, "save": "terrain" },
    { "tool": "terrain_edit", "args": { "op": "flatten_rect", "id": "$terrain.id", "min": [760, -620], "max": [1330, 320], "height": 1152, "margin": 420 } },
    { "tool": "terrain_edit", "args": { "op": "flatten_rect", "id": "$terrain.id", "min": [1400, -4096], "max": [4096, 4096], "height": 190, "margin": 30 } },
    { "tool": "terrain_edit", "args": { "op": "sculpt", "id": "$terrain.id", "mode": "noise", "center": [2700, 0, 0], "radius": 1600, "strength": 60 } },
    { "tool": "terrain_edit", "args": { "op": "sculpt", "id": "$terrain.id", "mode": "smooth", "center": [1360, 0, -2400], "radius": 900, "strength": 10 } },
    { "tool": "terrain_edit", "args": { "op": "auto_paint", "id": "$terrain.id", "rock_slope": 0.3, "top_height": 2150, "low_height": -1000 } },
    { "tool": "terrain_edit", "args": { "op": "paint_path", "id": "$terrain.id", "layer": 3, "radius": 70, "strength": 1,
      "points": [[1000, -120], [760, -40], [480, 70], [200, 130], [-80, 60], [-330, -120]] } },
    { "tool": "blend", "args": { "op": "dab", "ids": ["$terrain.id"], "mode": "noise", "layer": 3, "center": [1040, 1152, -150], "radius": 420, "strength": 0.9, "noise_scale": 150, "falloff": "smooth" } },
    { "tool": "blend", "args": { "op": "dab", "ids": ["$terrain.id"], "mode": "slope", "layer": 1, "slope": [38, 90], "center": [1380, 600, 0], "radius": 1800, "strength": 1, "falloff": "constant" } },
    { "tool": "create_mesh", "args": { "shape": "sphere", "min": [920, 1180, -620], "max": [1260, 1420, -260], "sides": 12, "material": "showcase/cliff",
      "roughen": { "amount": 40, "seed": 5 }, "uv_scale": 2, "smooth_angle": 50 } },

    { "note": "Hanging supports: deck, railings, cantilever beams anchored on the plateau, chains and struts from the cliff face." },
    { "tool": "hierarchy", "args": { "op": "add_layer", "name": "Hanging House" } },
    { "tool": "hierarchy", "args": { "op": "add_group", "name": "hanging supports" } },
    { "tool": "create_brush", "args": { "min": [1408, 872, -272], "max": [1888, 896, 272], "material": "showcase/planks_dark" } },
    { "tool": "create_brush", "args": { "min": [1421, 896, -269], "max": [1427, 936, -263], "material": "showcase/beam" }, "save": "post_north" },
    { "tool": "duplicate", "args": { "ids": ["$post_north.ids.0"], "offset": [64, 0, 0], "count": 7 } },
    { "tool": "create_brush", "args": { "min": [1421, 896, 263], "max": [1427, 936, 269], "material": "showcase/beam" }, "save": "post_south" },
    { "tool": "duplicate", "args": { "ids": ["$post_south.ids.0"], "offset": [64, 0, 0], "count": 7 } },
    { "tool": "create_brush", "args": { "min": [1552, 932, -270], "max": [1888, 938, -262], "material": "showcase/beam" } },
    { "tool": "create_brush", "args": { "min": [1408, 932, 262], "max": [1888, 938, 270], "material": "showcase/beam" } },
    { "tool": "create_brush", "args": { "min": [1882, 932, -272], "max": [1890, 938, 272], "material": "showcase/beam" } },
    { "tool": "create_brush", "args": { "min": [1060, 1144, -280], "max": [1188, 1216, -208], "material": "showcase/stone_bricks", "uv_scale": 0.5 }, "save": "anchor" },
    { "tool": "create_brush", "args": { "min": [1100, 1216, -256], "max": [1920, 1240, -232], "material": "showcase/beam" }, "save": "cantilever" },
    { "tool": "duplicate", "args": { "ids": ["$anchor.ids.0", "$cantilever.ids.0"], "offset": [0, 0, 488] } },
    { "tool": "create_mesh", "args": { "shape": "lathe", "center": [1904, 0, -244], "profile": [[3.5, 896], [3.5, 1216]], "sides": 8, "material": "showcase/metal", "smooth_angle": 60 }, "save": "chain" },
    { "tool": "duplicate", "args": { "ids": ["$chain.id"], "offset": [-264, 0, 0] } },
    { "tool": "duplicate", "args": { "ids": ["$chain.id"], "offset": [0, 0, 488] } },
    { "tool": "duplicate", "args": { "ids": ["$chain.id"], "offset": [-264, 0, 488] } },
    { "tool": "create_brush", "args": { "min": [1384, 611, -209], "max": [1853, 629, -191], "material": "showcase/beam" }, "save": "strut" },
    { "tool": "transform", "args": { "rotate": { "axis": "z", "degrees": 32.5, "center": [1384, 620, -200] } } },
    { "tool": "duplicate", "args": { "ids": ["$strut.ids.0"], "offset": [0, 0, 200], "count": 2 } },
    { "tool": "create_brush", "args": { "shape": "stairs", "min": [1360, 896, -600], "max": [1424, 1152, -344], "steps": 16, "material": "showcase/planks" } },
    { "tool": "create_brush", "args": { "min": [1296, 1136, -680], "max": [1424, 1152, -600], "material": "showcase/planks" } },
    { "tool": "create_brush", "args": { "min": [1360, 880, -344], "max": [1552, 896, -272], "material": "showcase/planks" } },
    { "tool": "hierarchy", "args": { "op": "close_group" } },

    { "note": "The cabin: one box hollowed into walls with the door and windows carved out, a hinged door that opens when you walk up, a gable roof." },
    { "tool": "hierarchy", "args": { "op": "add_group", "name": "cabin" } },
    { "tool": "create_brush", "args": { "min": [1440, 896, -208], "max": [1856, 1064, 208], "material": "showcase/logs", "hollow": 16,
      "openings": [
        [[1488, 912, -216], [1552, 1016, -184]],
        [[1832, 960, -120], [1864, 1032, -40]],
        [[1832, 960, 40], [1864, 1032, 120]],
        [[1600, 960, 184], [1700, 1032, 216]],
        [[1680, 960, -216], [1760, 1032, -184]]
      ] } },
    { "tool": "create_brush", "args": { "min": [1847, 960, -120], "max": [1849, 1032, -40], "material": "showcase/glass" }, "save": "pane" },
    { "tool": "duplicate", "args": { "ids": ["$pane.ids.0"], "offset": [0, 0, 160] } },
    { "tool": "create_brush", "args": { "min": [1600, 960, 199], "max": [1700, 1032, 201], "material": "showcase/glass" } },
    { "tool": "create_brush", "args": { "min": [1680, 960, -201], "max": [1760, 1032, -199], "material": "showcase/glass" } },
    { "tool": "create_brush", "args": { "min": [1850, 956, -124], "max": [1866, 960, -36], "material": "showcase/planks_dark" }, "save": "sill" },
    { "tool": "duplicate", "args": { "ids": ["$sill.ids.0"], "offset": [0, 0, 160] } },
    { "tool": "create_brush", "args": { "min": [1490, 912, -202], "max": [1550, 1014, -198], "material": "showcase/planks_dark" }, "save": "door_leaf" },
    { "tool": "gameplay", "args": { "op": "make_door", "ids": ["$door_leaf.ids.0"], "kind": "hinged", "side": "left", "angle": 95, "trigger": true,
      "properties": { "targetname": "cabin_door", "wait": "4" } }, "save": "cabin_door" },
    { "tool": "create_mesh", "args": { "shape": "gable_roof", "min": [1440, 1064, -208], "max": [1856, 1160, 208], "ridge_z": false, "thickness": 12, "overhang": 32,
      "material": "showcase/roof_red", "uv_scale": 1 } },
    { "tool": "create_brush", "args": { "shape": "gable", "ridge_x": true, "min": [1440, 1064, -208], "max": [1456, 1160, 208], "material": "showcase/planks" }, "save": "gable" },
    { "tool": "duplicate", "args": { "ids": ["$gable.ids.0"], "offset": [400, 0, 0] } },
    { "tool": "create_brush", "args": { "min": [1456, 1044, -108], "max": [1840, 1060, -92], "material": "showcase/beam" }, "save": "roof_beam" },
    { "tool": "duplicate", "args": { "ids": ["$roof_beam.ids.0"], "offset": [0, 0, 200] } },
    { "tool": "hierarchy", "args": { "op": "close_group" } },

    { "note": "Interior: table with chairs placed by rotating a copy around the table, bed, fireplace, shelves, barrel and a hanging lamp." },
    { "tool": "hierarchy", "args": { "op": "add_group", "name": "interior" } },
    { "tool": "create_brush", "args": { "min": [1560, 912, -80], "max": [1720, 914, 80], "material": "showcase/carpet" } },
    { "tool": "create_brush", "args": { "min": [1600, 940, -36], "max": [1680, 944, 36], "material": "showcase/planks" } },
    { "tool": "create_brush", "args": { "min": [1604, 914, -32], "max": [1610, 940, -26], "material": "showcase/planks_dark" }, "save": "leg" },
    { "tool": "duplicate", "args": { "ids": ["$leg.ids.0"], "offset": [66, 0, 0] }, "save": "leg2" },
    { "tool": "duplicate", "args": { "ids": ["$leg.ids.0", "$leg2.copies.0.0"], "offset": [0, 0, 58] } },
    { "tool": "hierarchy", "args": { "op": "add_group", "name": "chair" }, "save": "chair" },
    { "tool": "create_brush", "args": { "min": [1628, 928, -68], "max": [1652, 931, -48], "material": "showcase/planks" } },
    { "tool": "create_brush", "args": { "min": [1628, 931, -68], "max": [1652, 958, -65], "material": "showcase/planks" } },
    { "tool": "create_brush", "args": { "min": [1629, 912, -67], "max": [1632, 928, -64], "material": "showcase/planks_dark" }, "save": "chair_leg" },
    { "tool": "duplicate", "args": { "ids": ["$chair_leg.ids.0"], "offset": [19, 0, 0] }, "save": "chair_leg2" },
    { "tool": "duplicate", "args": { "ids": ["$chair_leg.ids.0", "$chair_leg2.copies.0.0"], "offset": [0, 0, 15] } },
    { "tool": "hierarchy", "args": { "op": "close_group" } },
    { "tool": "duplicate", "args": { "ids": ["$chair.id"], "offset": [0, 0, 0], "rotate_y": 180, "pivot": [1640, 912, 0], "linked": true } },
    { "tool": "create_brush", "args": { "min": [1470, 912, 100], "max": [1566, 930, 186], "material": "showcase/planks_dark" } },
    { "tool": "create_brush", "args": { "min": [1474, 930, 104], "max": [1562, 940, 182], "material": "showcase/plaster" } },
    { "tool": "create_brush", "args": { "min": [1476, 940, 110], "max": [1500, 946, 176], "material": "showcase/white_paint" } },
    { "tool": "create_brush", "args": { "min": [1504, 940, 104], "max": [1562, 943, 182], "material": "showcase/carpet" } },
    { "tool": "create_mesh", "args": { "shape": "arch_wall", "min": [-60, 0, -22], "max": [60, 88, 22], "opening_width": 56, "opening_height": 52, "sides": 10,
      "material": "showcase/stone_bricks", "rotate_y": 90, "translate": [1478, 912, 0], "uv_scale": 0.5 } },
    { "tool": "create_brush", "args": { "min": [1456, 912, -60], "max": [1462, 1000, 60], "material": "showcase/stone_bricks", "uv_scale": 0.5 } },
    { "tool": "create_brush", "args": { "min": [1456, 1000, -40], "max": [1490, 1204, 40], "material": "showcase/stone_bricks", "uv_scale": 0.5 } },
    { "tool": "create_brush", "args": { "min": [1462, 912, -24], "max": [1496, 916, 24], "material": "showcase/dirt" } },
    { "tool": "create_entity", "args": { "classname": "light", "origin": [1482, 932, 0], "properties": { "targetname": "hearth_fire", "light_energy": "2.2", "light_color": "255 140 60", "omni_range": "7" } } },
    { "tool": "create_brush", "args": { "min": [1600, 976, -190], "max": [1700, 980, -176], "material": "showcase/planks" }, "save": "shelf" },
    { "tool": "duplicate", "args": { "ids": ["$shelf.ids.0"], "offset": [0, 40, 0] } },
    { "tool": "create_mesh", "args": { "shape": "lathe", "center": [1800, 0, -150], "profile": [[14, 912], [18, 932], [14, 952]], "sides": 12, "material": "showcase/planks_dark", "smooth_angle": 40 } },
    { "tool": "create_mesh", "args": { "shape": "lathe", "center": [1650, 0, 0], "profile": [[3, 1026], [10, 1034], [4, 1044], [0, 1046]], "sides": 10, "material": "showcase/lamp", "smooth_angle": 50 } },
    { "tool": "create_mesh", "args": { "shape": "lathe", "center": [1650, 0, 0], "profile": [[1, 1044], [1, 1048]], "sides": 6, "material": "showcase/metal" } },
    { "tool": "create_entity", "args": { "classname": "light", "origin": [1650, 1020, 0], "properties": { "light_energy": "1.6", "light_color": "255 214 160", "omni_range": "12" } } },
    { "tool": "hierarchy", "args": { "op": "close_group", "all": true } },

    { "note": "Gameplay: player start, a ping pong lift up the cliff, a teleport that brings fallen players back, and a welcome message on map load." },
    { "tool": "hierarchy", "args": { "op": "add_layer", "name": "Gameplay" } },
    { "tool": "create_entity", "args": { "classname": "info_player_start", "origin": [1060, 1152, -80], "angles": [0, -90, 0] } },
    { "tool": "gameplay", "args": { "op": "place", "classname": "info_teleport_destination", "origin": [1000, 1152, 40], "angles": [0, -90, 0], "properties": { "targetname": "cliff_respawn" } } },
    { "tool": "gameplay", "args": { "op": "volume", "classname": "trigger_teleport", "min": [1420, 120, -3000], "max": [3800, 320, 3000],
      "properties": { "targetname": "valley_catch", "destination": "cliff_respawn", "filter_group": "player" } } },
    { "tool": "create_brush", "args": { "min": [1330, 200, 420], "max": [1410, 216, 500], "material": "showcase/metal" }, "save": "lift_floor" },
    { "tool": "gameplay", "args": { "op": "make_platform", "ids": ["$lift_floor.ids.0"], "travel": [0, 936, 0], "mode": 1 }, "save": "lift" },
    { "tool": "update_entity", "args": { "id": "$lift.id", "properties": { "targetname": "cliff_lift", "speed": "3", "wait": "2.5" } } },
    { "tool": "create_brush", "args": { "min": [1318, 190, 452], "max": [1326, 1168, 468], "material": "showcase/beam" }, "save": "lift_rail" },
    { "tool": "duplicate", "args": { "ids": ["$lift_rail.ids.0"], "offset": [96, 0, 0] } },
    { "tool": "gameplay", "args": { "op": "place", "classname": "logic_debug", "origin": [1100, 1200, 0], "properties": { "targetname": "welcome_log", "message": "{name}: {parameter}", "trace_all": "1" } } },
    { "tool": "gameplay", "args": { "op": "place", "classname": "logic_auto", "origin": [1100, 1200, 40],
      "outputs": [
        { "output": "map_spawn", "target": "welcome_log", "input": "write", "parameter": "Welcome to the hanging house" },
        { "output": "map_spawn", "target": "cliff_lift", "input": "start", "delay": 1 }
      ] } },

    { "note": "Forests from the built-in nature pack. Each set is its own layer and only covers the terrain, the house keeps them off itself." },
    { "tool": "scatter", "args": { "op": "install_models" } },
    { "tool": "scatter", "args": { "op": "new_set", "name": "mountain pines", "targets": ["$terrain.id"], "preset": "pines" }, "save": "pines" },
    { "tool": "scatter", "args": { "op": "fill", "id": "$pines.id", "density": 0.45, "slope": [0, 26], "height": [260, 1950], "seed": 7 } },
    { "tool": "scatter", "args": { "op": "erase", "id": "$pines.id", "center": [1250, 1152, -120], "radius": 620 } },
    { "tool": "scatter", "args": { "op": "stroke", "id": "$pines.id", "erase": true, "radius": 110, "points": [[1000, -120], [760, -40], [480, 70], [200, 130], [-80, 60]] } },
    { "tool": "scatter", "args": { "op": "new_set", "name": "valley oaks", "targets": ["$terrain.id"], "items": [
      { "source": "res://godottrench/nature/oak.bbmodel", "weight": 2, "scale": [0.9, 1.4], "spacing": 170, "sink": 4 },
      { "source": "res://godottrench/nature/birch.bbmodel", "weight": 1, "scale": [0.8, 1.2], "spacing": 110, "tilt": 4, "sink": 4 }
    ] }, "save": "oaks" },
    { "tool": "scatter", "args": { "op": "fill", "id": "$oaks.id", "density": 0.3, "slope": [0, 18], "height": [140, 460], "seed": 8 } },
    { "tool": "scatter", "args": { "op": "erase", "id": "$oaks.id", "center": [1370, 200, 460], "radius": 260 } },
    { "tool": "scatter", "args": { "op": "new_set", "name": "boulders", "targets": ["$terrain.id"], "preset": "rocks" }, "save": "rocks" },
    { "tool": "scatter", "args": { "op": "fill", "id": "$rocks.id", "density": 0.08, "slope": [14, 55], "seed": 9 } },
    { "tool": "scatter", "args": { "op": "new_set", "name": "plateau meadow", "targets": ["$terrain.id"], "preset": "grass", "visibility_range": 2600 }, "save": "grass" },
    { "tool": "scatter", "args": { "op": "paint", "id": "$grass.id", "center": [980, -330], "radius": 300, "density": 16, "slope": [0, 30], "seed": 10 } },
    { "tool": "scatter", "args": { "op": "paint", "id": "$grass.id", "center": [880, 120], "radius": 320, "density": 16, "slope": [0, 30], "seed": 11 } },
    { "tool": "scatter", "args": { "op": "stroke", "id": "$grass.id", "radius": 220, "density": 10, "slope": [0, 30], "seed": 12, "points": [[700, -40], [420, 70], [160, 130]] } },
    { "tool": "scatter", "args": { "op": "new_set", "name": "undergrowth", "targets": ["$terrain.id"], "preset": "undergrowth" }, "save": "bushes" },
    { "tool": "scatter", "args": { "op": "fill", "id": "$bushes.id", "density": 0.12, "slope": [0, 32], "height": [240, 1300], "seed": 13 } },
    { "tool": "scatter", "args": { "op": "erase", "id": "$bushes.id", "center": [1250, 1152, -120], "radius": 520 } },

    { "note": "Camera bookmarks for the overview, the hanging house and the interior, then save into the Godot demo project." },
    { "tool": "set_camera", "args": { "view": "3d", "position": [2700, 1150, 900], "look_at": [1640, 960, 0] } },
    { "tool": "run_action", "args": { "action": "store_camera", "args": { "slot": 1 } } },
    { "tool": "set_camera", "args": { "view": "3d", "position": [1780, 990, 150], "look_at": [1500, 930, -60] } },
    { "tool": "run_action", "args": { "action": "store_camera", "args": { "slot": 2 } } },
    { "tool": "set_camera", "args": { "view": "3d", "position": [4200, 2600, 3600], "look_at": [600, 900, -200] } },
    { "tool": "run_action", "args": { "action": "store_camera", "args": { "slot": 3 } } },
    { "tool": "run_action", "args": { "action": "select_none" } },
    { "tool": "validate_map", "args": {} },
    { "tool": "map_file", "args": { "op": "save", "path": "${save_dir}/mountain_house.gtm" } }
  ]
}
