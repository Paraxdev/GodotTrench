{
  "format": "godottrench-mcp-script",
  "vars": { "save_dir": "${project}/demo/maps/showcase" },
  "title": "Withered City",
  "description": "A lonely, withered city block at night. Crumbling concrete towers with broken floors and collapsed slabs, roads split by roots and dead trees, puddles and fog, and on the plaza huge glowing block letters that still say STILL HERE. Walk in from the east road, open the jammed shutter of the tall ruin, ride the lift to its roof and look down on the letters. Built entirely from MCP tool calls.",
  "steps": [
    {"tool": "map_file", "args": {"op": "new"}},
    {"tool": "set_map_properties", "args": {"properties": {"message": "Withered City", "sun_angles": "-34 150", "sun_color": "150 170 220", "sun_energy": "0.2", "ambient_color": "26 30 46", "sky_top_color": "5 7 16", "sky_horizon_color": "30 34 52", "sky_ground_color": "8 9 12", "fog_color": "24 28 42", "fog_density": "0.006"}}},

    {"note": "Ground: a flat terrain under the whole block. It only shows where roads and slabs are broken, in the empty lots and around the ruins, so its layers are moss, rubble, weeds and dirt, painted by hand."},
    {"tool": "hierarchy", "args": {"op": "add_layer", "name": "Ground"}},
    {"tool": "create_terrain", "args": {"origin": [-4096, 0, -4096], "resolution": 129, "cell_size": 64, "shape": "flat", "seed": 7, "auto_paint": false, "layers": [["withered/moss", 192], ["withered/rubble", 128], ["showcase/grass_dark", 128], ["showcase/dirt", 128]]}, "save": "ground"},
    {"tool": "terrain_edit", "args": {"op": "sculpt", "id": "$ground.id", "mode": "noise", "center": [1700, 0, 2100], "radius": 900, "strength": 3}},
    {"tool": "terrain_edit", "args": {"op": "sculpt", "id": "$ground.id", "mode": "noise", "center": [-200, 0, -2000], "radius": 900, "strength": 3}},
    {"tool": "terrain_edit", "args": {"op": "sculpt", "id": "$ground.id", "mode": "noise", "center": [2600, 0, -2000], "radius": 500, "strength": 2}},
    {"tool": "terrain_edit", "args": {"op": "sculpt", "id": "$ground.id", "mode": "noise", "center": [-2400, 0, 2500], "radius": 600, "strength": 2}},
    {"tool": "terrain_edit", "args": {"op": "sculpt", "id": "$ground.id", "mode": "raise", "center": [-1500, 0, -1700], "radius": 260, "strength": 24}},
    {"tool": "terrain_edit", "args": {"op": "sculpt", "id": "$ground.id", "mode": "raise", "center": [700, 0, -2000], "radius": 220, "strength": 24}},
    {"tool": "terrain_edit", "args": {"op": "sculpt", "id": "$ground.id", "mode": "raise", "center": [1300, 0, 1900], "radius": 240, "strength": 24}},
    {"tool": "terrain_edit", "args": {"op": "sculpt", "id": "$ground.id", "mode": "raise", "center": [-700, 0, 2350], "radius": 200, "strength": 24}},
    {"tool": "blend", "args": {"op": "dab", "ids": ["$ground.id"], "mode": "paint", "layer": 2, "center": [1700, 0, 2100], "radius": 1100, "strength": 0.8, "falloff": "smooth"}},
    {"tool": "blend", "args": {"op": "dab", "ids": ["$ground.id"], "mode": "paint", "layer": 2, "center": [-200, 0, -2100], "radius": 1100, "strength": 0.7, "falloff": "smooth"}},
    {"tool": "blend", "args": {"op": "dab", "ids": ["$ground.id"], "mode": "noise", "layer": 3, "center": [0, 0, 0], "radius": 3600, "strength": 0.5, "noise_scale": 300}},
    {"tool": "blend", "args": {"op": "dab", "ids": ["$ground.id"], "mode": "paint", "layer": 1, "center": [-1500, 0, -1700], "radius": 520, "strength": 0.9, "falloff": "smooth"}},
    {"tool": "blend", "args": {"op": "dab", "ids": ["$ground.id"], "mode": "paint", "layer": 1, "center": [700, 0, -2000], "radius": 420, "strength": 0.9, "falloff": "smooth"}},
    {"tool": "blend", "args": {"op": "dab", "ids": ["$ground.id"], "mode": "paint", "layer": 1, "center": [1300, 0, 1900], "radius": 440, "strength": 0.9, "falloff": "smooth"}},
    {"tool": "blend", "args": {"op": "dab", "ids": ["$ground.id"], "mode": "paint", "layer": 1, "center": [-700, 0, 2350], "radius": 400, "strength": 0.9, "falloff": "smooth"}},
    {"tool": "blend", "args": {"op": "dab", "ids": ["$ground.id"], "mode": "paint", "layer": 1, "center": [-2000, 0, -1800], "radius": 600, "strength": 0.9, "falloff": "smooth"}},

    {"note": "Plaza: twenty cracked tile slabs with gaps between them. One corner slab has sunk into a puddle, another was heaved up by roots, and two lost a corner to the clip tool so weeds grow through."},
    {"tool": "hierarchy", "args": {"op": "add_layer", "name": "Plaza"}},
    {"tool": "hierarchy", "args": {"op": "add_group", "name": "plaza slabs"}},
    {"tool": "create_brush", "args": {"min": [-1232, -16, -848], "max": [-752, 6, -436], "material": "withered/tiles"}, "save": "t00"},
    {"tool": "duplicate", "args": {"ids": "$t00.ids", "offset": [496, 0, 0], "count": 4}, "save": "cols"},
    {"tool": "duplicate", "args": {"ids": ["$t00.ids.0", "$cols.copies.0.0", "$cols.copies.1.0", "$cols.copies.2.0", "$cols.copies.3.0"], "offset": [0, 0, 428], "count": 3}, "save": "rows"},
    {"tool": "select", "args": {"ids": "$t00.ids"}},
    {"tool": "transform", "args": {"translate": [0, -36, 0], "rotate": {"axis": "x", "degrees": 5}}},
    {"tool": "select", "args": {"ids": ["$cols.copies.3.0"]}},
    {"tool": "transform", "args": {"rotate": {"axis": "z", "degrees": -4}}},
    {"tool": "select", "args": {"ids": ["$rows.copies.2.1"]}},
    {"tool": "run_action", "args": {"action": "clip_apply", "args": {"point": [-560, 0, 700], "normal": [-0.6, 0, -0.8], "keep": "front"}}},
    {"tool": "select", "args": {"ids": ["$rows.copies.2.3"]}},
    {"tool": "run_action", "args": {"action": "clip_apply", "args": {"point": [620, 0, 520], "normal": [-0.3, 0, 0.95], "keep": "back"}}},
    {"tool": "select", "args": {"ids": ["$rows.copies.0.4"]}},
    {"tool": "run_action", "args": {"action": "move_vertices", "args": {"vertices": [[1232, 6, -420], [1232, 6, -8]], "offset": [0, -18, 0]}}},
    {"tool": "hierarchy", "args": {"op": "close_group"}},
    {"tool": "create_mesh", "args": {"shape": "grid", "min": [-1228, -36, -844], "max": [-756, -36, -440], "divisions": 1, "material": "withered/puddle"}, "save": "plaza_puddle"},
    {"tool": "gameplay", "args": {"op": "brush_entity", "ids": ["$plaza_puddle.id"], "classname": "func_illusionary"}},

    {"note": "The letters: one create_brush call with shape text lays STILL over HERE out as block letter brushes, readable from the south and from the tower roof. Glowing paint (withered/letters emits through its _emission map). The I has tipped, the last E lost a corner and the H sags where the slab below it gave way."},
    {"tool": "hierarchy", "args": {"op": "add_layer", "name": "Letters"}},
    {"tool": "create_brush", "args": {"shape": "text", "text": "STILL\nHERE", "min": [-812, 6, -448], "max": [812, 12, 448], "material": "withered/letters"}, "save": "word"},
    {"tool": "select", "args": {"ids": "$word.letters.2"}},
    {"tool": "transform", "args": {"translate": [0, 6, 0], "rotate": {"axis": "z", "degrees": 4}}},
    {"tool": "select", "args": {"ids": "$word.letters.8"}},
    {"tool": "run_action", "args": {"action": "clip_apply", "args": {"point": [540, 0, 380], "normal": [0.7, 0, 0.7], "keep": "back"}}},
    {"tool": "select", "args": {"ids": "$word.letters.5"}},
    {"tool": "run_action", "args": {"action": "move_vertices", "args": {"vertices": [[-644, 12, 448], [-644, 6, 448]], "offset": [0, -5, 0]}}},
    {"tool": "create_entity", "args": {"classname": "light", "origin": [-520, 44, -250], "properties": {"light_energy": "1.6", "light_color": "255 166 76", "omni_range": "11"}}},
    {"tool": "create_entity", "args": {"classname": "light", "origin": [40, 44, -250], "properties": {"light_energy": "1.6", "light_color": "255 166 76", "omni_range": "11"}}},
    {"tool": "create_entity", "args": {"classname": "light", "origin": [560, 44, -250], "properties": {"light_energy": "1.6", "light_color": "255 166 76", "omni_range": "11"}}},
    {"tool": "create_entity", "args": {"classname": "light", "origin": [-440, 44, 250], "properties": {"light_energy": "1.6", "light_color": "255 166 76", "omni_range": "11"}}},
    {"tool": "create_entity", "args": {"classname": "light", "origin": [60, 44, 250], "properties": {"light_energy": "1.6", "light_color": "255 166 76", "omni_range": "11", "targetname": "letter_flicker"}}},
    {"tool": "create_entity", "args": {"classname": "light", "origin": [480, 44, 250], "properties": {"light_energy": "1.6", "light_color": "255 166 76", "omni_range": "11"}}},
    {"tool": "create_entity", "args": {"classname": "logic_timer", "origin": [60, 80, 250], "properties": {"targetname": "flicker_clock", "interval": "0.4", "random_min": "0.05", "random_max": "1.2"}, "outputs": [{"output": "timer", "target": "letter_flicker", "input": "toggle"}]}},

    {"note": "Roads: asphalt slabs split by crack cutters (thin rotated brushes subtracted with CSG) and shallow potholes that hold water."},
    {"tool": "hierarchy", "args": {"op": "add_layer", "name": "Streets"}},
    {"tool": "hierarchy", "args": {"op": "add_group", "name": "roads"}},
    {"tool": "create_brush", "args": {"min": [-4096, -16, 1000], "max": [4096, 4, 1300], "material": "withered/asphalt"}, "save": "road_s"},
    {"tool": "create_brush", "args": {"min": [1400, -16, -4096], "max": [1700, 4, 1000], "material": "withered/asphalt"}, "save": "road_e"},
    {"tool": "create_brush", "args": {"min": [-4096, -16, -1300], "max": [1400, 4, -1000], "material": "withered/asphalt"}, "save": "road_n"},
    {"tool": "create_brush", "args": {"min": [-2900, -16, -4096], "max": [-2600, 4, -1300], "material": "withered/asphalt"}},
    {"tool": "create_brush", "args": {"min": [-2900, -16, -1000], "max": [-2600, 4, 1000], "material": "withered/asphalt"}},
    {"tool": "create_brush", "args": {"min": [-2900, -16, 1300], "max": [-2600, 4, 4096], "material": "withered/asphalt"}},
    {"tool": "hierarchy", "args": {"op": "close_group"}},
    {"tool": "hierarchy", "args": {"op": "add_group", "name": "sidewalks"}},
    {"tool": "create_brush", "args": {"min": [-2700, -16, 840], "max": [1400, 8, 1000], "material": "withered/pavers"}},
    {"tool": "create_brush", "args": {"min": [-2700, -16, 1300], "max": [2700, 8, 1440], "material": "withered/pavers"}},
    {"tool": "create_brush", "args": {"min": [-2700, -16, -1000], "max": [1240, 8, -840], "material": "withered/pavers"}},
    {"tool": "create_brush", "args": {"min": [1240, -16, -840], "max": [1400, 8, 840], "material": "withered/pavers"}},
    {"tool": "create_brush", "args": {"min": [1700, -16, -2700], "max": [1860, 8, 1000], "material": "withered/pavers"}},
    {"tool": "create_brush", "args": {"min": [-1400, -16, -840], "max": [-1240, 8, 840], "material": "withered/pavers"}},
    {"tool": "hierarchy", "args": {"op": "close_group"}},
    {"tool": "create_brush", "args": {"min": [-1710.0, -40, 1140], "max": [-1290.0, 40, 1160], "material": "withered/rubble"}},
    {"tool": "transform", "args": {"rotate": {"axis": "y", "degrees": 64}}},
    {"tool": "run_action", "args": {"action": "csg_subtract"}},
    {"tool": "create_brush", "args": {"min": [-30.0, -40, 1130], "max": [350.0, 40, 1150], "material": "withered/rubble"}},
    {"tool": "transform", "args": {"rotate": {"axis": "y", "degrees": 118}}},
    {"tool": "run_action", "args": {"action": "csg_subtract"}},
    {"tool": "create_brush", "args": {"min": [1700.0, -40, 1150], "max": [2100.0, 40, 1170], "material": "withered/rubble"}},
    {"tool": "transform", "args": {"rotate": {"axis": "y", "degrees": 75}}},
    {"tool": "run_action", "args": {"action": "csg_subtract"}},
    {"tool": "create_brush", "args": {"min": [1360.0, -40, -310], "max": [1740.0, 40, -290], "material": "withered/rubble"}},
    {"tool": "transform", "args": {"rotate": {"axis": "y", "degrees": 20}}},
    {"tool": "run_action", "args": {"action": "csg_subtract"}},
    {"tool": "create_brush", "args": {"min": [1360.0, -40, -1710], "max": [1720.0, 40, -1690], "material": "withered/rubble"}},
    {"tool": "transform", "args": {"rotate": {"axis": "y", "degrees": 160}}},
    {"tool": "run_action", "args": {"action": "csg_subtract"}},
    {"tool": "create_brush", "args": {"min": [-790.0, -40, -1160], "max": [-410.0, 40, -1140], "material": "withered/rubble"}},
    {"tool": "transform", "args": {"rotate": {"axis": "y", "degrees": 70}}},
    {"tool": "run_action", "args": {"action": "csg_subtract"}},
    {"tool": "create_brush", "args": {"min": [1070.0, -40, 910], "max": [1290.0, 40, 930], "material": "withered/rubble"}},
    {"tool": "transform", "args": {"rotate": {"axis": "y", "degrees": 30}}},
    {"tool": "run_action", "args": {"action": "csg_subtract"}},
    {"tool": "create_brush", "args": {"min": [530, 1, 1126.0], "max": [710, 20, 1234.0], "material": "withered/rubble"}},
    {"tool": "transform", "args": {"rotate": {"axis": "y", "degrees": 20}}},
    {"tool": "run_action", "args": {"action": "csg_subtract"}},
    {"tool": "create_mesh", "args": {"shape": "grid", "min": [539.0, 2.5, 1099.0], "max": [701.0, 2.5, 1261.0], "divisions": 1, "material": "withered/puddle", "rotate_y": 20}, "save": "pud"},
    {"tool": "gameplay", "args": {"op": "brush_entity", "ids": ["$pud.id"], "classname": "func_illusionary"}},
    {"tool": "create_brush", "args": {"min": [-970, 1, 1038.0], "max": [-830, 20, 1122.0], "material": "withered/rubble"}},
    {"tool": "transform", "args": {"rotate": {"axis": "y", "degrees": 55}}},
    {"tool": "run_action", "args": {"action": "csg_subtract"}},
    {"tool": "create_mesh", "args": {"shape": "grid", "min": [-963.0, 2.5, 1017.0], "max": [-837.0, 2.5, 1143.0], "divisions": 1, "material": "withered/puddle", "rotate_y": 55}, "save": "pud"},
    {"tool": "gameplay", "args": {"op": "brush_entity", "ids": ["$pud.id"], "classname": "func_illusionary"}},
    {"tool": "create_brush", "args": {"min": [1480, 1, 372.0], "max": [1640, 20, 468.0], "material": "withered/rubble"}},
    {"tool": "transform", "args": {"rotate": {"axis": "y", "degrees": 10}}},
    {"tool": "run_action", "args": {"action": "csg_subtract"}},
    {"tool": "create_mesh", "args": {"shape": "grid", "min": [1488.0, 2.5, 348.0], "max": [1632.0, 2.5, 492.0], "divisions": 1, "material": "withered/puddle", "rotate_y": 10}, "save": "pud"},
    {"tool": "gameplay", "args": {"op": "brush_entity", "ids": ["$pud.id"], "classname": "func_illusionary"}},
    {"tool": "create_brush", "args": {"min": [-2110, 1, 1154.0], "max": [-1890, 20, 1286.0], "material": "withered/rubble"}},
    {"tool": "transform", "args": {"rotate": {"axis": "y", "degrees": 35}}},
    {"tool": "run_action", "args": {"action": "csg_subtract"}},
    {"tool": "create_mesh", "args": {"shape": "grid", "min": [-2099.0, 2.5, 1121.0], "max": [-1901.0, 2.5, 1319.0], "divisions": 1, "material": "withered/puddle", "rotate_y": 35}, "save": "pud"},
    {"tool": "gameplay", "args": {"op": "brush_entity", "ids": ["$pud.id"], "classname": "func_illusionary"}},

    {"note": "The tall ruin south of the road, the lookout: six storeys as hollow boxes with windows, a lift shaft cut through every slab, a jammed shutter in the doorway and a bite out of the south west corner."},
    {"tool": "hierarchy", "args": {"op": "add_layer", "name": "Lookout"}},
    {"tool": "hierarchy", "args": {"op": "add_group", "name": "lookout shell"}},
    {"tool": "create_brush", "args": {"min": [-384, 0, 1440], "max": [384, 128, 1920], "material": "withered/concrete", "hollow": 16, "openings": [{"min": [-288.0, 40, 1436], "max": [-224.0, 104, 1460], "count": 2, "step": [128, 0, 0]}, {"min": [96.0, 40, 1436], "max": [160.0, 104, 1460], "count": 2, "step": [128, 0, 0]}, {"min": [-288.0, 40, 1900], "max": [-224.0, 104, 1924], "count": 5, "step": [128, 0, 0]}, {"min": [-388, 40, 1520.0], "max": [-364, 104, 1584.0], "count": 3, "step": [0, 0, 128]}, {"min": [364, 40, 1520.0], "max": [388, 104, 1584.0], "count": 3, "step": [0, 0, 128]}, [[208, 17, 1464], [352, 129, 1608]], [[-64, 16, 1436], [64, 112, 1460]]]}, "save": "lookout_0"},
    {"tool": "create_brush", "args": {"min": [-384, 128, 1440], "max": [384, 256, 1920], "material": "withered/concrete_panels", "hollow": 16, "openings": [{"min": [-288.0, 168, 1436], "max": [-224.0, 232, 1460], "count": 5, "step": [128, 0, 0]}, {"min": [-288.0, 168, 1900], "max": [-224.0, 232, 1924], "count": 5, "step": [128, 0, 0]}, {"min": [-388, 168, 1520.0], "max": [-364, 232, 1584.0], "count": 3, "step": [0, 0, 128]}, {"min": [364, 168, 1520.0], "max": [388, 232, 1584.0], "count": 3, "step": [0, 0, 128]}, [[208, 127, 1464], [352, 257, 1608]]]}, "save": "lookout_1"},
    {"tool": "duplicate", "args": {"ids": "$lookout_1.ids", "offset": [0, 128, 0], "count": 4}},
    {"tool": "create_brush", "args": {"min": [-384, 768, 1440], "max": [384, 800, 1456], "material": "withered/concrete"}, "save": "parapet_n"},
    {"tool": "create_brush", "args": {"min": [-384, 768, 1904], "max": [384, 800, 1920], "material": "withered/concrete"}},
    {"tool": "create_brush", "args": {"min": [-384, 768, 1456], "max": [-368, 800, 1904], "material": "withered/concrete"}},
    {"tool": "create_brush", "args": {"min": [368, 768, 1456], "max": [384, 800, 1904], "material": "withered/concrete"}},
    {"tool": "hierarchy", "args": {"op": "close_group"}},

    {"note": "Break the tower: a rotated cutter bites the south west corner off the top floors, a blast hole opens the north facade, and the parapet in front of the view has crumbled."},
    {"tool": "create_brush", "args": {"min": [-560, 540, 1760], "max": [-200, 900, 2100], "material": "withered/rubble"}},
    {"tool": "transform", "args": {"rotate": {"axis": "y", "degrees": 35}}},
    {"tool": "run_action", "args": {"action": "csg_subtract"}},
    {"tool": "create_brush", "args": {"min": [-300, 280, 1400], "max": [-150, 360, 1480], "material": "withered/rubble"}},
    {"tool": "transform", "args": {"rotate": {"axis": "z", "degrees": 25}}},
    {"tool": "run_action", "args": {"action": "csg_subtract"}},
    {"tool": "create_brush", "args": {"min": [-290, 250, 1380], "max": [-170, 262, 1470], "material": "withered/slab"}},
    {"tool": "transform", "args": {"rotate": {"axis": "x", "degrees": -28}}},
    {"tool": "create_brush", "args": {"min": [-120, 780, 1420], "max": [60, 820, 1470], "material": "withered/rubble"}},
    {"tool": "transform", "args": {"rotate": {"axis": "z", "degrees": -14}}},
    {"tool": "run_action", "args": {"action": "csg_subtract"}},
    {"tool": "create_brush", "args": {"min": [216, 16, 1472], "max": [344, 24, 1600], "material": "withered/rust"}, "save": "lift"},
    {"tool": "gameplay", "args": {"op": "make_platform", "ids": "$lift.ids", "travel": [0, 744, 0], "mode": 0, "properties": {"targetname": "lift", "speed": "2.5", "wait": "0"}}},

    {"note": "Buttons on posts next to the shaft call the lift, one on the ground floor and one on the roof."},
    {"tool": "create_brush", "args": {"min": [168, 16, 1560], "max": [184, 64, 1576], "material": "withered/concrete"}},
    {"tool": "create_brush", "args": {"min": [170, 64, 1562], "max": [182, 70, 1574], "material": "withered/rust"}, "save": "lift_button_low"},
    {"tool": "gameplay", "args": {"op": "make_button", "ids": "$lift_button_low.ids", "target": "lift", "input": "toggle", "properties": {"targetname": "lift_call_low"}}},
    {"tool": "create_brush", "args": {"min": [168, 768, 1624], "max": [184, 816, 1640], "material": "withered/concrete"}},
    {"tool": "create_brush", "args": {"min": [170, 816, 1626], "max": [182, 822, 1638], "material": "withered/rust"}, "save": "lift_button_roof"},
    {"tool": "gameplay", "args": {"op": "make_button", "ids": "$lift_button_roof.ids", "target": "lift", "input": "toggle", "properties": {"targetname": "lift_call_roof"}}},
    {"tool": "create_brush", "args": {"min": [204, 768, 1612], "max": [356, 808, 1620], "material": "withered/rust"}},
    {"tool": "create_entity", "args": {"classname": "game_text", "origin": [176, 84, 1556], "angles": [0, 180, 0], "properties": {"text": "ROOF", "start_visible": "1", "billboard": "0", "world_size": "0.012", "text_color": "255 176 90"}}},

    {"note": "The doorway: a rusted shutter that slides up, jammed until you press the button beside it."},
    {"tool": "create_brush", "args": {"min": [-64, 16, 1444], "max": [64, 112, 1452], "material": "withered/shutter"}, "save": "shutter"},
    {"tool": "gameplay", "args": {"op": "make_door", "ids": "$shutter.ids", "kind": "sliding", "direction": "up", "lip": 10, "properties": {"targetname": "shutter", "wait": "12", "speed": "0.8"}}},
    {"tool": "create_brush", "args": {"min": [88, 56, 1432], "max": [104, 72, 1440], "material": "withered/rust"}, "save": "shutter_button"},
    {"tool": "gameplay", "args": {"op": "make_button", "ids": "$shutter_button.ids", "target": "shutter", "input": "open", "properties": {"targetname": "shutter_button"}}},
    {"tool": "create_entity", "args": {"classname": "light", "origin": [0, 96, 1500], "properties": {"light_energy": "0.6", "light_color": "140 170 220", "omni_range": "6"}}},

