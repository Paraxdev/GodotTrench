{
  "format": "godottrench-mcp-script",
  "vars": { "save_dir": "${project}/demo/maps/showcase" },
  "title": "Night District",
  "description": "The industrial edge of a residential block at night: a cracked street under sodium lamps, apartment blocks with lit windows, a corner shop with a neon sign and an automatic door, a back alley with a flickering lamp, a warehouse whose roller door runs on a switch and whose tube lights come on as you walk in, a fenced yard, a courtyard that lights up when entered and a train crossing the viaduct. Built entirely from MCP tool calls.",
  "steps": [
    { "tool": "map_file", "args": { "op": "new" } },
    { "tool": "set_map_properties", "args": { "properties": {
      "message": "Night District",
      "sun_angles": "-38 150", "sun_color": "150 172 230", "sun_energy": "0.16", "ambient_color": "46 52 84", "ambient_energy": "0.8",
      "sky_top_color": "6 8 20", "sky_horizon_color": "58 44 52", "sky_ground_color": "10 10 14", "sky_energy": "0.6",
      "fog_color": "38 32 42", "fog_density": "0.01", "glow_intensity": "0.9"
    } } },

    { "note": "Street along x with sidewalks raised by an 8 unit curb. The street top is y = 0, sidewalks and ground floors y = 8. North of the street (z < -272) stand the apartments, the shop and the warehouse, south of it (z > 272) a second block, a rowhouse and a parking lot." },
    { "tool": "hierarchy", "args": { "op": "add_layer", "name": "Street" } },
    { "tool": "create_brush", "args": { "min": [-2560, -32, -160], "max": [2560, 0, 160], "material": "night/asphalt" } },
    { "tool": "create_brush", "args": { "min": [-2560, -32, -176], "max": [2560, 8, -160], "material": "night/cracked_concrete" } },
    { "tool": "create_brush", "args": { "min": [-2560, -32, 160], "max": [2560, 8, 176], "material": "night/cracked_concrete" } },
    { "tool": "create_brush", "args": { "min": [-2560, -32, -272], "max": [2560, 8, -176], "material": "night/sidewalk" }, "save": "walk_n" },
    { "tool": "create_brush", "args": { "min": [-2560, -32, 176], "max": [2560, 8, 272], "material": "night/sidewalk" }, "save": "walk_s" },

    { "note": "Sodium street lamps: a pole, an arm over the road, a housing with a glowing lens and a spot light pointing down. One lamp is built as a group, the others are linked copies, so editing one edits all." },
    { "tool": "hierarchy", "args": { "op": "add_layer", "name": "Lamps" } },
    { "tool": "hierarchy", "args": { "op": "add_group", "name": "lamp north" }, "save": "lamp_n" },
    { "tool": "create_brush", "args": { "shape": "cylinder", "sides": 8, "min": [-1222, 8, -214], "max": [-1210, 280, -202], "material": "night/rusty_metal" } },
    { "tool": "create_brush", "args": { "min": [-1219, 268, -202], "max": [-1213, 276, -136], "material": "night/rusty_metal" } },
    { "tool": "create_brush", "args": { "min": [-1230, 262, -148], "max": [-1202, 278, -112], "material": "night/rusty_metal" } },
    { "tool": "create_brush", "args": { "min": [-1228, 259, -146], "max": [-1204, 262, -114], "material": "showcase/lamp" } },
    { "tool": "create_entity", "args": { "classname": "light_spot", "origin": [-1216, 250, -130], "angles": [-90, 0, 0],
      "properties": { "light_energy": "7", "light_color": "255 176 104", "spot_range": "13", "spot_angle": "58", "shadows": "1" } } },
    { "tool": "hierarchy", "args": { "op": "close_group" } },
    { "tool": "duplicate", "args": { "ids": ["$lamp_n.id"], "offset": [640, 0, 0], "count": 5, "linked": true } },
    { "tool": "hierarchy", "args": { "op": "add_group", "name": "lamp south" }, "save": "lamp_s" },
    { "tool": "create_brush", "args": { "shape": "cylinder", "sides": 8, "min": [-774, 8, 202], "max": [-762, 280, 214], "material": "night/rusty_metal" } },
    { "tool": "create_brush", "args": { "min": [-771, 268, 136], "max": [-765, 276, 202], "material": "night/rusty_metal" } },
    { "tool": "create_brush", "args": { "min": [-782, 262, 112], "max": [-754, 278, 148], "material": "night/rusty_metal" } },
    { "tool": "create_brush", "args": { "min": [-780, 259, 114], "max": [-756, 262, 146], "material": "showcase/lamp" } },
    { "tool": "create_entity", "args": { "classname": "light_spot", "origin": [-768, 250, 130], "angles": [-90, 0, 0],
      "properties": { "light_energy": "7", "light_color": "255 176 104", "spot_range": "13", "spot_angle": "58" } } },
    { "tool": "hierarchy", "args": { "op": "close_group" } },
    { "tool": "duplicate", "args": { "ids": ["$lamp_s.id"], "offset": [640, 0, 0], "count": 3, "linked": true } },

    { "note": "Apartment block A: five floors of lit facade, a flat roof and a small lobby behind a door that opens with the intercom button." },
    { "tool": "hierarchy", "args": { "op": "add_layer", "name": "Apartments" } },
    { "tool": "hierarchy", "args": { "op": "add_group", "name": "apartment A" } },
    { "tool": "create_brush", "args": { "min": [-1152, 8, -720], "max": [-608, 488, -272], "material": "night/apartment_lit",
      "openings": [[[-944, 8, -432], [-800, 104, -288]], [[-896, 8, -289], [-848, 96, -271]]] } },
    { "tool": "create_brush", "args": { "min": [-1160, 488, -728], "max": [-600, 504, -264], "material": "night/cracked_concrete" } },
    { "tool": "create_brush", "args": { "min": [-944, 8, -432], "max": [-800, 10, -288], "material": "base/floor" } },
    { "tool": "create_brush", "args": { "min": [-944, 10, -432], "max": [-800, 104, -428], "material": "showcase/plaster" } },
    { "tool": "create_brush", "args": { "min": [-944, 10, -428], "max": [-940, 104, -288], "material": "showcase/plaster" } },
    { "tool": "create_brush", "args": { "min": [-804, 10, -428], "max": [-800, 104, -288], "material": "showcase/plaster" } },
    { "tool": "create_brush", "args": { "min": [-940, 100, -428], "max": [-804, 104, -288], "material": "showcase/plaster" } },
    { "tool": "create_brush", "args": { "min": [-880, 97, -372], "max": [-864, 100, -348], "material": "showcase/lamp" } },
    { "tool": "create_entity", "args": { "classname": "light", "origin": [-872, 86, -360], "properties": { "light_energy": "1.2", "light_color": "255 214 160", "omni_range": "6" } } },
    { "tool": "create_brush", "args": { "min": [-908, 100, -272], "max": [-836, 106, -248], "material": "night/rusty_metal" } },
    { "tool": "create_brush", "args": { "min": [-880, 97, -266], "max": [-864, 100, -254], "material": "showcase/lamp" } },
    { "tool": "create_entity", "args": { "classname": "light", "origin": [-872, 88, -258], "properties": { "light_energy": "0.9", "light_color": "255 220 170", "omni_range": "5" } } },
    { "tool": "hierarchy", "args": { "op": "close_group" } },
    { "tool": "create_brush", "args": { "min": [-896, 8, -284], "max": [-848, 96, -280], "material": "showcase/planks_dark" }, "save": "lobby_leaf" },
    { "tool": "gameplay", "args": { "op": "make_door", "ids": ["$lobby_leaf.ids.0"], "kind": "hinged", "side": "left", "angle": 100, "properties": { "targetname": "lobby_door", "wait": "5", "interact": "0" } } },
    { "tool": "create_brush", "args": { "min": [-834, 48, -272], "max": [-826, 64, -268], "material": "base/metal" }, "save": "intercom" },
    { "tool": "gameplay", "args": { "op": "make_button", "ids": ["$intercom.ids.0"], "target": "lobby_door", "input": "open", "properties": { "travel": "0 0 1" } } },

    { "note": "Apartment block B across the street: a darker building with only its street front lit, the lit facade shifted so its windows differ from block A." },
    { "tool": "hierarchy", "args": { "op": "add_group", "name": "apartment B" } },
    { "tool": "create_brush", "args": { "min": [-1024, 8, 288], "max": [-320, 392, 656], "material": "night/apartment_dark" } },
    { "tool": "create_brush", "args": { "min": [-1024, 8, 272], "max": [-320, 392, 288], "material": "night/apartment_lit" }, "save": "b_front" },
    { "tool": "texture", "args": { "op": "shift", "texels": [288, 192] } },
    { "tool": "create_brush", "args": { "min": [-1032, 392, 264], "max": [-312, 408, 664], "material": "night/cracked_concrete" } },
    { "tool": "hierarchy", "args": { "op": "close_group" } },

    { "note": "Corner shop: brick walls, a lit shop window, a glass door that slides open on its own, a neon sign and a flat roof." },
    { "tool": "hierarchy", "args": { "op": "add_layer", "name": "Shop" } },
    { "tool": "hierarchy", "args": { "op": "add_group", "name": "shop" } },
    { "tool": "create_brush", "args": { "min": [-608, 8, -560], "max": [-288, 184, -272], "material": "night/dark_brick", "hollow": 16,
      "openings": [[[-592, 40, -289], [-448, 144, -271]], [[-416, 8, -289], [-352, 136, -271]]] } },
    { "tool": "create_brush", "args": { "min": [-592, 24, -544], "max": [-304, 26, -288], "material": "base/floor" } },
    { "tool": "create_brush", "args": { "min": [-592, 40, -282], "max": [-448, 144, -278], "material": "showcase/glass" } },
    { "tool": "create_brush", "args": { "min": [-584, 180, -276], "max": [-328, 244, -268], "material": "night/shop_sign" } },
    { "tool": "texture", "args": { "op": "justify", "mode": "fit" } },
    { "tool": "create_brush", "args": { "min": [-596, 144, -276], "max": [-444, 148, -272], "material": "night/neon_red" } },
    { "tool": "create_brush", "args": { "min": [-596, 36, -276], "max": [-444, 40, -272], "material": "night/neon_red" } },
    { "tool": "create_brush", "args": { "min": [-560, 24, -420], "max": [-480, 64, -360], "material": "showcase/planks_dark" } },
    { "tool": "create_brush", "args": { "min": [-520, 164, -440], "max": [-376, 168, -424], "material": "showcase/lamp" } },
    { "tool": "create_entity", "args": { "classname": "light", "origin": [-448, 150, -400], "properties": { "light_energy": "3.2", "light_color": "240 244 255", "omni_range": "9" } } },
    { "tool": "create_entity", "args": { "classname": "light", "origin": [-520, 100, -300], "properties": { "light_energy": "1.0", "light_color": "255 120 100", "omni_range": "5" } } },
    { "tool": "create_entity", "args": { "classname": "prop_model", "origin": [-440, 24, -536], "angles": [0, 0, 0], "properties": { "model": "res://models/polyhaven/furniture/wooden_bookshelf_worn.gltf" } } },
    { "tool": "create_entity", "args": { "classname": "prop_model", "origin": [-340, 24, -536], "angles": [0, 0, 0], "properties": { "model": "res://models/polyhaven/furniture/wooden_bookshelf_worn.gltf" } } },
    { "tool": "create_entity", "args": { "classname": "prop_model", "origin": [-360, 24, -330], "angles": [0, 25, 0], "properties": { "model": "res://models/polyhaven/containers/cardboard_box_01.gltf" } } },
    { "tool": "hierarchy", "args": { "op": "close_group" } },
    { "tool": "create_brush", "args": { "min": [-416, 8, -282], "max": [-352, 136, -278], "material": "showcase/glass" }, "save": "shop_leaf" },
    { "tool": "gameplay", "args": { "op": "make_door", "ids": ["$shop_leaf.ids.0"], "kind": "sliding", "direction": "left", "lip": 4, "trigger": true, "properties": { "targetname": "shop_door", "wait": "3", "speed": "2.5" } } },

    { "note": "Back alley between the shop and the warehouse, running north into the courtyard. Dumpsters and pallets are grouped brushes, the lamp on the warehouse wall flickers from a random timer, and its bulb follows the light through the fixture key." },
    { "tool": "hierarchy", "args": { "op": "add_layer", "name": "Alley" } },
    { "tool": "create_brush", "args": { "min": [-288, -32, -1040], "max": [-96, 8, -272], "material": "night/cracked_concrete" }, "save": "alley_floor" },
    { "tool": "hierarchy", "args": { "op": "add_group", "name": "dumpster" }, "save": "dumpster" },
    { "tool": "create_brush", "args": { "min": [-280, 14, -700], "max": [-224, 72, -604], "material": "night/rusty_metal" } },
    { "tool": "create_brush", "args": { "min": [-283, 72, -703], "max": [-221, 76, -601], "material": "night/rusty_metal" } },
    { "tool": "create_brush", "args": { "min": [-276, 8, -696], "max": [-270, 14, -690], "material": "base/metal" } },
    { "tool": "create_brush", "args": { "min": [-234, 8, -696], "max": [-228, 14, -690], "material": "base/metal" } },
    { "tool": "create_brush", "args": { "min": [-276, 8, -614], "max": [-270, 14, -608], "material": "base/metal" } },
    { "tool": "create_brush", "args": { "min": [-234, 8, -614], "max": [-228, 14, -608], "material": "base/metal" } },
    { "tool": "hierarchy", "args": { "op": "close_group" } },
    { "tool": "duplicate", "args": { "ids": ["$dumpster.id"], "offset": [0, 0, -120] } },
    { "tool": "hierarchy", "args": { "op": "add_group", "name": "pallet" }, "save": "pallet" },
    { "tool": "create_brush", "args": { "min": [-150, 8, -420], "max": [-112, 12, -414], "material": "showcase/planks" } },
    { "tool": "create_brush", "args": { "min": [-150, 8, -401], "max": [-112, 12, -395], "material": "showcase/planks" } },
    { "tool": "create_brush", "args": { "min": [-150, 8, -382], "max": [-112, 12, -376], "material": "showcase/planks" } },
    { "tool": "create_brush", "args": { "min": [-150, 12, -420], "max": [-112, 14, -376], "material": "showcase/planks" } },
    { "tool": "hierarchy", "args": { "op": "close_group" } },
    { "tool": "duplicate", "args": { "ids": ["$pallet.id"], "offset": [0, 6, 0], "count": 3 } },
    { "tool": "duplicate", "args": { "ids": ["$pallet.id"], "offset": [0, 0, -60], "rotate_y": 12 } },
    { "tool": "create_entity", "args": { "classname": "prop_model", "origin": [-260, 8, -470], "angles": [0, 15, 0], "properties": { "model": "res://models/polyhaven/containers/Barrel_01.gltf" } } },
    { "tool": "create_entity", "args": { "classname": "prop_model", "origin": [-236, 8, -448], "angles": [0, 70, 0], "properties": { "model": "res://models/polyhaven/containers/barrel_03.gltf" } } },
    { "tool": "create_entity", "args": { "classname": "prop_model", "origin": [-120, 8, -850], "angles": [0, -30, 0], "properties": { "model": "res://models/polyhaven/containers/Barrel_01.gltf" } } },
    { "tool": "create_entity", "args": { "classname": "prop_model", "origin": [-250, 8, -560], "angles": [0, 40, 0], "properties": { "model": "res://models/polyhaven/containers/trashbag.gltf", "collision": "none" } } },
    { "tool": "create_entity", "args": { "classname": "prop_model", "origin": [-232, 8, -580], "angles": [0, 160, 0], "properties": { "model": "res://models/polyhaven/containers/trashbag.gltf", "collision": "none" } } },
    { "tool": "create_entity", "args": { "classname": "prop_model", "origin": [-200, 14, -340], "angles": [0, 30, 0], "properties": { "model": "res://models/polyhaven/containers/cardboard_box_01.gltf" } } },
    { "tool": "create_entity", "args": { "classname": "prop_model", "origin": [-104, 250, -720], "angles": [0, -90, 0], "properties": { "model": "res://models/polyhaven/lighting/security_light.gltf", "collision": "none" } } },
    { "tool": "create_entity", "args": { "classname": "light", "origin": [-128, 236, -720],
      "properties": { "targetname": "alley_lamp", "light_energy": "2.4", "light_color": "226 236 255", "omni_range": "10", "shadows": "1", "fixture": "alley_bulb", "fixture_off": "dark" } } },
    { "tool": "create_brush", "args": { "min": [-116, 232, -730], "max": [-110, 244, -710], "material": "showcase/lamp" }, "save": "alley_bulb" },
    { "tool": "gameplay", "args": { "op": "brush_entity", "ids": ["$alley_bulb.ids.0"], "classname": "func_illusionary", "properties": { "targetname": "alley_bulb" } } },
    { "tool": "gameplay", "args": { "op": "place", "classname": "logic_timer", "origin": [-160, 280, -720],
      "properties": { "targetname": "alley_flicker", "random_min": "0.04", "random_max": "0.9" },
      "outputs": [{ "output": "timer", "target": "alley_lamp", "input": "toggle" }] } },

    { "note": "Warehouse: corrugated walls around a hollow hall, a roller door on a switch with an orange beacon while it moves, a side door to the alley, and tube lights that switch on one after another when you walk in." },
    { "tool": "hierarchy", "args": { "op": "add_layer", "name": "Warehouse" } },
    { "tool": "hierarchy", "args": { "op": "add_group", "name": "warehouse shell" } },
    { "tool": "create_brush", "args": { "min": [-96, 8, -960], "max": [640, 312, -272], "material": "night/corrugated", "hollow": 16,
      "openings": [[[64, 8, -289], [320, 184, -271]], [[-97, 8, -560], [-79, 120, -496]]] } },
    { "tool": "create_brush", "args": { "min": [-80, 24, -944], "max": [624, 26, -288], "material": "night/cracked_concrete" } },
    { "tool": "create_brush", "args": { "min": [48, 184, -276], "max": [336, 200, -266], "material": "night/rusty_metal" } },
    { "tool": "create_entity", "args": { "classname": "prop_model", "origin": [480, 230, -268], "angles": [0, 180, 0], "properties": { "model": "res://models/polyhaven/lighting/security_light.gltf", "collision": "none" } } },
    { "tool": "create_entity", "args": { "classname": "light_spot", "origin": [480, 222, -250], "angles": [-65, 180, 0],
      "properties": { "light_energy": "4", "light_color": "235 240 255", "spot_range": "12", "spot_angle": "48", "shadows": "1" } } },
    { "tool": "create_entity", "args": { "classname": "prop_model", "origin": [-76, 214, -270], "angles": [0, 150, 0], "properties": { "model": "res://models/polyhaven/industrial/security_camera_01.gltf", "collision": "none" } } },
    { "tool": "hierarchy", "args": { "op": "close_group" } },
    { "tool": "create_brush", "args": { "min": [64, 8, -282], "max": [320, 184, -278], "material": "night/roller_door" }, "save": "roller" },
    { "tool": "gameplay", "args": { "op": "make_door", "ids": ["$roller.ids.0"], "kind": "sliding", "direction": "up", "lip": 12,
      "properties": { "targetname": "garage_door", "speed": "0.9", "wait": "-1", "interact": "0" },
      "outputs": [
        { "output": "started_opening", "target": "garage_beacon", "input": "turn_on" },
        { "output": "started_closing", "target": "garage_beacon", "input": "turn_on" },
        { "output": "opened", "target": "garage_beacon", "input": "turn_off" },
        { "output": "closed", "target": "garage_beacon", "input": "turn_off" }
      ] } },
    { "tool": "create_brush", "args": { "min": [340, 60, -272], "max": [356, 88, -266], "material": "base/metal" }, "save": "garage_switch" },
    { "tool": "gameplay", "args": { "op": "make_button", "ids": ["$garage_switch.ids.0"], "target": "garage_door", "input": "toggle", "properties": { "travel": "0 0 -2" } } },
    { "tool": "create_entity", "args": { "classname": "light", "origin": [192, 212, -256], "properties": { "targetname": "garage_beacon", "light_energy": "3", "light_color": "255 140 30", "omni_range": "6", "start_on": "0" } } },
    { "tool": "create_brush", "args": { "min": [-92, 8, -560], "max": [-88, 120, -496], "material": "night/rusty_metal" }, "save": "side_leaf" },
    { "tool": "gameplay", "args": { "op": "make_door", "ids": ["$side_leaf.ids.0"], "kind": "hinged", "side": "right", "angle": 95, "properties": { "targetname": "warehouse_side_door", "wait": "4" } } },
    { "tool": "hierarchy", "args": { "op": "add_group", "name": "hall lights" } },
    { "tool": "create_brush", "args": { "min": [16, 288, -632], "max": [144, 292, -620], "material": "showcase/lamp" }, "save": "tube_1" },
    { "tool": "gameplay", "args": { "op": "brush_entity", "ids": ["$tube_1.ids.0"], "classname": "func_illusionary", "properties": { "targetname": "hall_tube_1" } } },
    { "tool": "create_brush", "args": { "min": [208, 288, -632], "max": [336, 292, -620], "material": "showcase/lamp" }, "save": "tube_2" },
    { "tool": "gameplay", "args": { "op": "brush_entity", "ids": ["$tube_2.ids.0"], "classname": "func_illusionary", "properties": { "targetname": "hall_tube_2" } } },
    { "tool": "create_brush", "args": { "min": [400, 288, -632], "max": [528, 292, -620], "material": "showcase/lamp" }, "save": "tube_3" },
    { "tool": "gameplay", "args": { "op": "brush_entity", "ids": ["$tube_3.ids.0"], "classname": "func_illusionary", "properties": { "targetname": "hall_tube_3" } } },
    { "tool": "create_entity", "args": { "classname": "light", "origin": [80, 270, -626], "properties": { "targetname": "hall_light_1", "light_energy": "2.2", "light_color": "226 238 255", "omni_range": "14", "start_on": "0", "fixture": "hall_tube_1" } } },
    { "tool": "create_entity", "args": { "classname": "light", "origin": [272, 270, -626], "properties": { "targetname": "hall_light_2", "light_energy": "2.2", "light_color": "226 238 255", "omni_range": "14", "start_on": "0", "fixture": "hall_tube_2" } } },
    { "tool": "create_entity", "args": { "classname": "light", "origin": [464, 270, -626], "properties": { "targetname": "hall_light_3", "light_energy": "2.2", "light_color": "226 238 255", "omni_range": "14", "start_on": "0", "fixture": "hall_tube_3" } } },
    { "tool": "hierarchy", "args": { "op": "close_group" } },
    { "tool": "gameplay", "args": { "op": "volume", "classname": "trigger_once", "min": [64, 26, -420], "max": [320, 140, -300], "properties": { "targetname": "hall_entry" },
      "outputs": [
        { "output": "triggered", "target": "hall_light_1", "input": "turn_on", "delay": 0.2 },
        { "output": "triggered", "target": "hall_light_2", "input": "turn_on", "delay": 0.8 },
