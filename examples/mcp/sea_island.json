{
  "format": "godottrench-mcp-script",
  "vars": {"save_dir": "${project}/demo/maps/showcase"},
  "title": "Sea Island",
  "description": "A large island in the sea, built the way the sea island tutorial in the docs does it: an island terrain lowered into a water brush, two hills, terraced cliffs on the north east coast, a flattened beach, sand, rock and grass painted with height and slope masks, dirt paths from the beach to the hilltops, a mixed woodland with hero trees, bushes, cliff boulders with grass growing on them, meadow grass kept off the paths, and a pier with Poly Haven props.",
  "steps": [
    {"tool": "map_file", "args": {"op": "new"}},
    {"tool": "set_map_properties", "args": {"properties": {"message": "Sea Island", "sun_angles": "-35 -125", "sun_color": "255 236 210", "sun_energy": "1.1", "ambient_color": "96 108 132", "sky_top_color": "70 124 196", "sky_horizon_color": "206 220 232", "sky_ground_color": "64 96 120", "fog_color": "196 212 226", "fog_density": "0.00012"}}},

    {"note": "The terrain from Terrain > Create Terrain: 257 x 257 vertices, 64 unit cells, island shape, auto paint off. The origin is lowered by 576 units so the sea at y = 0 covers the outer third."},
    {"tool": "create_terrain", "args": {"origin": [-8192, -576, -8192], "resolution": 257, "cell_size": 64, "shape": "island", "height": 1600, "seed": 1, "feature_size": 3000, "erosion": 20, "auto_paint": false, "layers": [["showcase/grass", 256], ["showcase/cliff", 256], ["showcase/dirt", 192], ["showcase/sand", 192]]}, "save": "island"},

    {"note": "The sea: one flat water brush at y = 0, made a func_illusionary so it has no collision."},
    {"tool": "create_brush", "args": {"min": [-262144, -32, -262144], "max": [262144, 0, 262144], "material": "showcase/water", "uv_scale": 8, "entity": {"classname": "func_illusionary"}}},

    {"note": "Hills: a broad raise west of the centre with a steeper top, and a lower hill to the south east."},
    {"tool": "terrain_edit", "args": {"mode": "raise", "center": [-2200, -600], "radius": 2800, "strength": 650, "op": "sculpt", "id": "$island.id"}},
    {"tool": "terrain_edit", "args": {"mode": "raise", "center": [-2000, -900], "radius": 1300, "strength": 420, "op": "sculpt", "id": "$island.id"}},
    {"tool": "terrain_edit", "args": {"mode": "raise", "center": [2400, 1400], "radius": 1900, "strength": 480, "op": "sculpt", "id": "$island.id"}},

    {"note": "Cliffs: raise a headland along the north east coast, smooth everything once, deepen the water in front of it, then terrace its seaward face."},
    {"tool": "terrain_edit", "args": {"mode": "raise", "points": [[-1200, -2400], [600, -3700], [2400, -3900], [3900, -3100], [4700, -1900]], "radius": 1800, "strength": 200, "spacing": 500, "op": "sculpt_path", "id": "$island.id"}},
    {"tool": "terrain_edit", "args": {"mode": "smooth", "center": [0, 0], "radius": 7000, "strength": 16, "op": "sculpt", "id": "$island.id"}},
    {"tool": "terrain_edit", "args": {"mode": "lower", "points": [[400, -5200], [2400, -5400], [4600, -4500], [5900, -2600]], "radius": 1000, "strength": 300, "spacing": 300, "op": "sculpt_path", "id": "$island.id"}},
    {"tool": "terrain_edit", "args": {"mode": "terrace", "points": [[600, -4400], [2400, -4600], [4100, -3800], [5100, -2300]], "radius": 1000, "strength": 12, "step": 300, "spacing": 250, "op": "sculpt_path", "id": "$island.id"}},
    {"tool": "terrain_edit", "args": {"mode": "smooth", "points": [[600, -4400], [2400, -4600], [4100, -3800], [5100, -2300]], "radius": 1000, "strength": 4, "spacing": 250, "op": "sculpt_path", "id": "$island.id"}},

    {"note": "Beach: flatten the south shore to just above the waterline and smooth the edge."},
    {"tool": "terrain_edit", "args": {"mode": "flatten", "points": [[-2600, 4300], [-800, 4700], [1000, 4800], [2600, 4400]], "radius": 900, "strength": 10, "height": 8, "spacing": 300, "op": "sculpt_path", "id": "$island.id"}},
    {"tool": "terrain_edit", "args": {"mode": "smooth", "points": [[-2600, 4300], [-800, 4700], [1000, 4800], [2600, 4400]], "radius": 1100, "strength": 12, "spacing": 300, "op": "sculpt_path", "id": "$island.id"}},

    {"note": "Sand below 40 units everywhere with a height masked dab, then a wider band on the south beach."},
    {"tool": "blend", "args": {"mode": "height", "layer": 3, "height": [-3000, 40], "center": [0, 0, 0], "radius": 12000, "strength": 1, "falloff": "constant", "op": "dab", "ids": ["$island.id"]}},
    {"tool": "blend", "args": {"mode": "paint", "layer": 3, "points": [[-2600, 4300], [-800, 4700], [1000, 4800], [2600, 4400]], "radius": 700, "strength": 0.7, "falloff": "smooth", "op": "stroke", "ids": ["$island.id"]}},

    {"note": "Rock on everything steeper than 32 degrees with a slope masked dab."},
    {"tool": "blend", "args": {"mode": "slope", "layer": 1, "slope": [32, 90], "center": [0, 0, 0], "radius": 12000, "strength": 1, "falloff": "constant", "op": "dab", "ids": ["$island.id"]}},

    {"note": "Dirt paths: from the beach up the big hill, from its top along the ridge to the cliffs, and from the beach to the second hill."},
    {"tool": "blend", "args": {"mode": "paint", "layer": 2, "points": [[200, 4400], [420, 3900], [300, 3400], [-200, 3000], [-700, 2600], [-950, 2100], [-850, 1500], [-1150, 1000], [-1550, 600], [-1700, 100], [-1750, -350], [-2000, -800]], "radius": 140, "strength": 0.8, "falloff": "smooth", "op": "stroke", "ids": ["$island.id"]}},
    {"tool": "blend", "args": {"mode": "paint", "layer": 2, "points": [[-1900, -1150], [-1500, -1500], [-1000, -1950], [-400, -2300], [300, -2650], [1000, -2950], [1700, -3150], [2300, -3300]], "radius": 140, "strength": 0.8, "falloff": "smooth", "op": "stroke", "ids": ["$island.id"]}},
    {"tool": "blend", "args": {"mode": "paint", "layer": 2, "points": [[1300, 4300], [1550, 3800], [1900, 3350], [2400, 2950], [2700, 2500], [2650, 2000], [2450, 1500]], "radius": 140, "strength": 0.8, "falloff": "smooth", "op": "stroke", "ids": ["$island.id"]}},

    {"note": "Break up the repeat: de-tile every layer, strongest on the cliff rock."},
    {"tool": "terrain_edit", "args": {"layers": [["showcase/grass", 256, 0.5, 0.5], ["showcase/cliff", 256, 0.7, 0.4], ["showcase/dirt", 192, 0.5, 0.5], ["showcase/sand", 192, 0.4, 0.5]], "op": "set_layers", "id": "$island.id"}},

    {"note": "Woodland: the mixed woodland preset filled over the island above the beach, cleared off the paths and out of two clearings."},
    {"tool": "scatter", "args": {"op": "install_models"}},
    {"tool": "scatter", "args": {"name": "woodland", "targets": ["$island.id"], "preset": "mixed woodland", "op": "new_set"}, "save": "woods"},
    {"tool": "scatter", "args": {"id": "$woods.id", "density": 0.16, "slope": [0, 30], "height": [120, 2000], "seed": 41, "falloff": 0.3, "only_targets": true, "avoid_other_sets": true, "amount": 1.0, "op": "fill"}},
    {"tool": "scatter", "args": {"id": "$woods.id", "erase": true, "radius": 260, "points": [[200, 4400], [420, 3900], [300, 3400], [-200, 3000], [-700, 2600], [-950, 2100], [-850, 1500], [-1150, 1000], [-1550, 600], [-1700, 100], [-1750, -350], [-2000, -800]], "height": null, "falloff": 0.3, "only_targets": true, "avoid_other_sets": true, "amount": 1.0, "op": "stroke"}},
    {"tool": "scatter", "args": {"id": "$woods.id", "erase": true, "radius": 260, "points": [[-1900, -1150], [-1500, -1500], [-1000, -1950], [-400, -2300], [300, -2650], [1000, -2950], [1700, -3150], [2300, -3300]], "height": null, "falloff": 0.3, "only_targets": true, "avoid_other_sets": true, "amount": 1.0, "op": "stroke"}},
    {"tool": "scatter", "args": {"id": "$woods.id", "erase": true, "radius": 260, "points": [[1300, 4300], [1550, 3800], [1900, 3350], [2400, 2950], [2700, 2500], [2650, 2000], [2450, 1500]], "height": null, "falloff": 0.3, "only_targets": true, "avoid_other_sets": true, "amount": 1.0, "op": "stroke"}},
    {"tool": "scatter", "args": {"id": "$woods.id", "center": [-2150, -650], "radius": 520, "height": null, "falloff": 0.3, "only_targets": true, "avoid_other_sets": true, "amount": 1.0, "op": "erase"}},
    {"tool": "scatter", "args": {"id": "$woods.id", "center": [700, 3000], "radius": 700, "height": null, "falloff": 0.3, "only_targets": true, "avoid_other_sets": true, "amount": 1.0, "op": "erase"}},

    {"note": "A few detailed hero trees where the paths leave the beach and on the hilltop clearing."},
    {"tool": "scatter", "args": {"name": "hero trees", "targets": ["$island.id"], "preset": "detailed forest", "op": "new_set"}, "save": "hero"},
    {"tool": "scatter", "args": {"id": "$hero.id", "center": [-450, 3500], "radius": 260, "density": 0.08, "slope": [0, 30], "seed": 50, "height": null, "falloff": 0.3, "only_targets": true, "avoid_other_sets": true, "amount": 1.0, "op": "paint"}},
    {"tool": "scatter", "args": {"id": "$hero.id", "center": [1150, 3700], "radius": 260, "density": 0.08, "slope": [0, 30], "seed": 51, "height": null, "falloff": 0.3, "only_targets": true, "avoid_other_sets": true, "amount": 1.0, "op": "paint"}},
    {"tool": "scatter", "args": {"id": "$hero.id", "center": [-1750, -250], "radius": 260, "density": 0.08, "slope": [0, 30], "seed": 52, "height": null, "falloff": 0.3, "only_targets": true, "avoid_other_sets": true, "amount": 1.0, "op": "paint"}},
    {"tool": "scatter", "args": {"id": "$hero.id", "center": [-2600, -900], "radius": 260, "density": 0.08, "slope": [0, 30], "seed": 53, "height": null, "falloff": 0.3, "only_targets": true, "avoid_other_sets": true, "amount": 1.0, "op": "paint"}},
    {"tool": "scatter", "args": {"id": "$hero.id", "erase": true, "radius": 200, "points": [[200, 4400], [420, 3900], [300, 3400], [-200, 3000], [-700, 2600], [-950, 2100], [-850, 1500], [-1150, 1000], [-1550, 600], [-1700, 100], [-1750, -350], [-2000, -800]], "height": null, "falloff": 0.3, "only_targets": true, "avoid_other_sets": true, "amount": 1.0, "op": "stroke"}},
    {"tool": "scatter", "args": {"id": "$hero.id", "erase": true, "radius": 200, "points": [[-1900, -1150], [-1500, -1500], [-1000, -1950], [-400, -2300], [300, -2650], [1000, -2950], [1700, -3150], [2300, -3300]], "height": null, "falloff": 0.3, "only_targets": true, "avoid_other_sets": true, "amount": 1.0, "op": "stroke"}},
    {"tool": "scatter", "args": {"id": "$hero.id", "erase": true, "radius": 200, "points": [[1300, 4300], [1550, 3800], [1900, 3350], [2400, 2950], [2700, 2500], [2650, 2000], [2450, 1500]], "height": null, "falloff": 0.3, "only_targets": true, "avoid_other_sets": true, "amount": 1.0, "op": "stroke"}},

    {"note": "Bushes along the edge of the wood, a band just above the sand."},
    {"tool": "scatter", "args": {"name": "bushes", "targets": ["$island.id"], "preset": "bushes", "op": "new_set"}, "save": "bushes"},
    {"tool": "scatter", "args": {"id": "$bushes.id", "density": 0.35, "slope": [0, 32], "height": [45, 200], "seed": 60, "falloff": 0.3, "only_targets": true, "avoid_other_sets": true, "amount": 1.0, "op": "fill"}},
    {"tool": "scatter", "args": {"id": "$bushes.id", "erase": true, "radius": 190, "points": [[200, 4400], [420, 3900], [300, 3400], [-200, 3000], [-700, 2600], [-950, 2100], [-850, 1500], [-1150, 1000], [-1550, 600], [-1700, 100], [-1750, -350], [-2000, -800]], "height": null, "falloff": 0.3, "only_targets": true, "avoid_other_sets": true, "amount": 1.0, "op": "stroke"}},
    {"tool": "scatter", "args": {"id": "$bushes.id", "erase": true, "radius": 190, "points": [[-1900, -1150], [-1500, -1500], [-1000, -1950], [-400, -2300], [300, -2650], [1000, -2950], [1700, -3150], [2300, -3300]], "height": null, "falloff": 0.3, "only_targets": true, "avoid_other_sets": true, "amount": 1.0, "op": "stroke"}},
    {"tool": "scatter", "args": {"id": "$bushes.id", "erase": true, "radius": 190, "points": [[1300, 4300], [1550, 3800], [1900, 3350], [2400, 2950], [2700, 2500], [2650, 2000], [2450, 1500]], "height": null, "falloff": 0.3, "only_targets": true, "avoid_other_sets": true, "amount": 1.0, "op": "stroke"}},

    {"note": "Boulders along the cliff tops and faces."},
    {"tool": "scatter", "args": {"name": "cliff boulders", "targets": ["$island.id"], "preset": "boulders", "op": "new_set"}, "save": "boulders"},
    {"tool": "scatter", "args": {"id": "$boulders.id", "points": [[600, -4400], [2400, -4600], [4100, -3800], [5100, -2300]], "radius": 1100, "density": 0.035, "slope": [12, 50], "height": [20, 2000], "seed": 70, "falloff": 0.3, "only_targets": true, "avoid_other_sets": true, "amount": 1.0, "op": "stroke"}},

    {"note": "Grass and flowers in the clearings and meadows, kept off the paths."},
    {"tool": "scatter", "args": {"name": "meadow grass", "targets": ["$island.id"], "preset": "grass", "op": "new_set"}, "save": "grass"},
    {"tool": "scatter", "args": {"id": "$grass.id", "center": [500, 3500], "radius": 650, "density": 2.5, "slope": [0, 28], "height": [45, 2000], "seed": 80, "falloff": 0.3, "only_targets": true, "avoid_other_sets": true, "amount": 1.0, "op": "paint"}},
    {"tool": "scatter", "args": {"id": "$grass.id", "center": [900, 2900], "radius": 650, "density": 2.5, "slope": [0, 28], "height": [45, 2000], "seed": 81, "falloff": 0.3, "only_targets": true, "avoid_other_sets": true, "amount": 1.0, "op": "paint"}},
    {"tool": "scatter", "args": {"id": "$grass.id", "center": [300, 2600], "radius": 650, "density": 2.5, "slope": [0, 28], "height": [45, 2000], "seed": 82, "falloff": 0.3, "only_targets": true, "avoid_other_sets": true, "amount": 1.0, "op": "paint"}},
    {"tool": "scatter", "args": {"id": "$grass.id", "center": [-300, 3300], "radius": 650, "density": 2.5, "slope": [0, 28], "height": [45, 2000], "seed": 83, "falloff": 0.3, "only_targets": true, "avoid_other_sets": true, "amount": 1.0, "op": "paint"}},
    {"tool": "scatter", "args": {"id": "$grass.id", "center": [-2150, -650], "radius": 650, "density": 2.5, "slope": [0, 28], "height": [45, 2000], "seed": 84, "falloff": 0.3, "only_targets": true, "avoid_other_sets": true, "amount": 1.0, "op": "paint"}},
    {"tool": "scatter", "args": {"id": "$grass.id", "center": [-1900, -300], "radius": 650, "density": 2.5, "slope": [0, 28], "height": [45, 2000], "seed": 85, "falloff": 0.3, "only_targets": true, "avoid_other_sets": true, "amount": 1.0, "op": "paint"}},
    {"tool": "scatter", "args": {"id": "$grass.id", "erase": true, "radius": 170, "points": [[200, 4400], [420, 3900], [300, 3400], [-200, 3000], [-700, 2600], [-950, 2100], [-850, 1500], [-1150, 1000], [-1550, 600], [-1700, 100], [-1750, -350], [-2000, -800]], "height": null, "falloff": 0.3, "only_targets": true, "avoid_other_sets": true, "amount": 1.0, "op": "stroke"}},
    {"tool": "scatter", "args": {"id": "$grass.id", "erase": true, "radius": 170, "points": [[-1900, -1150], [-1500, -1500], [-1000, -1950], [-400, -2300], [300, -2650], [1000, -2950], [1700, -3150], [2300, -3300]], "height": null, "falloff": 0.3, "only_targets": true, "avoid_other_sets": true, "amount": 1.0, "op": "stroke"}},
    {"tool": "scatter", "args": {"id": "$grass.id", "erase": true, "radius": 170, "points": [[1300, 4300], [1550, 3800], [1900, 3350], [2400, 2950], [2700, 2500], [2650, 2000], [2450, 1500]], "height": null, "falloff": 0.3, "only_targets": true, "avoid_other_sets": true, "amount": 1.0, "op": "stroke"}},

    {"note": "Grass on the boulders: a second grass set whose only target is the boulder set."},
    {"tool": "scatter", "args": {"name": "boulder grass", "targets": ["$boulders.id"], "preset": "grass", "op": "new_set"}, "save": "moss"},
    {"tool": "scatter", "args": {"id": "$moss.id", "density": 6, "slope": [0, 45], "seed": 90, "height": null, "falloff": 0.3, "only_targets": true, "avoid_other_sets": true, "amount": 1.0, "op": "fill"}},

    {"note": "The pier: a plank deck on two rows of posts, reaching from the beach into water about 8 m deep."},
    {"tool": "hierarchy", "args": {"op": "add_layer", "name": "Pier"}},
    {"tool": "hierarchy", "args": {"op": "add_group", "name": "pier"}},
    {"tool": "create_brush", "args": {"min": [136, 40, 4650], "max": [264, 48, 5750], "material": "showcase/planks"}},
    {"tool": "create_brush", "args": {"min": [128, -320, 4792], "max": [144, 40, 4808], "material": "showcase/beam"}},
    {"tool": "create_brush", "args": {"min": [256, -320, 4792], "max": [272, 40, 4808], "material": "showcase/beam"}},
    {"tool": "create_brush", "args": {"min": [128, -320, 4992], "max": [144, 40, 5008], "material": "showcase/beam"}},
    {"tool": "create_brush", "args": {"min": [256, -320, 4992], "max": [272, 40, 5008], "material": "showcase/beam"}},
    {"tool": "create_brush", "args": {"min": [128, -320, 5192], "max": [144, 40, 5208], "material": "showcase/beam"}},
    {"tool": "create_brush", "args": {"min": [256, -320, 5192], "max": [272, 40, 5208], "material": "showcase/beam"}},
    {"tool": "create_brush", "args": {"min": [128, -320, 5392], "max": [144, 40, 5408], "material": "showcase/beam"}},
    {"tool": "create_brush", "args": {"min": [256, -320, 5392], "max": [272, 40, 5408], "material": "showcase/beam"}},
    {"tool": "create_brush", "args": {"min": [128, -320, 5592], "max": [144, 40, 5608], "material": "showcase/beam"}},
    {"tool": "create_brush", "args": {"min": [256, -320, 5592], "max": [272, 40, 5608], "material": "showcase/beam"}},
    {"tool": "create_brush", "args": {"min": [128, -320, 5732], "max": [144, 40, 5748], "material": "showcase/beam"}},
    {"tool": "create_brush", "args": {"min": [256, -320, 5732], "max": [272, 40, 5748], "material": "showcase/beam"}},
    {"tool": "create_brush", "args": {"min": [128, 48, 5726], "max": [144, 88, 5742], "material": "showcase/beam"}},
    {"tool": "create_brush", "args": {"min": [256, 48, 5726], "max": [272, 88, 5742], "material": "showcase/beam"}},
    {"tool": "hierarchy", "args": {"op": "close_group", "all": true}},

    {"note": "Poly Haven props from the demo project: crates and a barrel on the deck, a lifebuoy and a buoy in the water."},
    {"tool": "import_model", "args": {"path": "${project}/models/polyhaven/containers/wooden_crate_01.gltf", "mode": "prop", "origin": [170, 48, 5480]}},
    {"tool": "import_model", "args": {"path": "${project}/models/polyhaven/containers/wooden_crate_01.gltf", "mode": "prop", "origin": [168, 72, 5484]}},
    {"tool": "import_model", "args": {"path": "${project}/models/polyhaven/containers/wine_barrel_01.gltf", "mode": "prop", "origin": [230, 48, 5560]}},
    {"tool": "import_model", "args": {"path": "${project}/models/polyhaven/nautical/lifebuoy.gltf", "mode": "prop", "origin": [220, 48, 5250]}},
    {"tool": "import_model", "args": {"path": "${project}/models/polyhaven/nautical/ocean_buoy.gltf", "mode": "prop", "origin": [450, 0, 6300]}},

    {"note": "Camera bookmarks: 1 the island from the south beach, 2 the north east cliffs, 3 the path up the big hill."},
    {"tool": "set_camera", "args": {"view": "3d", "position": [-5200, 3400, 9800], "look_at": [-300, 300, 500]}},
    {"tool": "run_action", "args": {"action": "store_camera", "args": {"slot": 1}}},
    {"tool": "set_camera", "args": {"view": "3d", "position": [2600, 700, -6800], "look_at": [2000, 300, -3500]}},
    {"tool": "run_action", "args": {"action": "store_camera", "args": {"slot": 2}}},
    {"tool": "set_camera", "args": {"view": "3d", "position": [-450, 700, 4300], "look_at": [-900, 300, 1800]}},
    {"tool": "run_action", "args": {"action": "store_camera", "args": {"slot": 3}}},
    {"tool": "run_action", "args": {"action": "select_none"}},
    {"tool": "map_file", "args": {"op": "save", "path": "${save_dir}/sea_island.gtm"}}
  ]
}
