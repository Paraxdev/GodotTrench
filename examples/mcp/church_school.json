{
  "format": "godottrench-mcp-script",
  "vars": { "save_dir": "${project}/demo/maps/showcase" },
  "title": "Church and School",
  "description": "A village church with arcades, stained glass, pews as linked groups, a bell tower with double doors, a school wing with a classroom puzzle that opens the courtyard gate, a blended courtyard floor and village woods. Built entirely from MCP tool calls.",
  "steps": [
    { "tool": "map_file", "args": { "op": "new" } },
    { "tool": "set_map_properties", "args": { "properties": {
      "message": "Church and School",
      "sun_angles": "-42 -35", "sun_color": "255 244 225", "sun_energy": "1.15", "ambient_color": "76 86 104",
      "sky_top_color": "82 128 196", "sky_horizon_color": "196 210 224", "sky_ground_color": "112 116 110",
      "fog_color": "190 204 218", "fog_density": "0.0002"
    } } },

    { "note": "Rolling hills flattened where the village stands, with a dirt road leading out from the church doors." },
    { "tool": "hierarchy", "args": { "op": "add_layer", "name": "Ground" } },
    { "tool": "create_terrain", "args": {
      "origin": [-4096, 0, -4096], "resolution": 65, "cell_size": 128, "shape": "hills", "height": 320, "seed": 21, "feature_size": 2400, "erosion": 4,
      "auto_paint": false, "layers": [["showcase/grass", 384], ["showcase/grass_dark", 256], ["showcase/dirt", 256], ["showcase/cobble", 128]]
    }, "save": "ground" },
    { "tool": "terrain_edit", "args": { "op": "flatten_rect", "id": "$ground.id", "min": [-720, -900], "max": [1260, 1100], "height": -4, "margin": 700 } },
    { "tool": "terrain_edit", "args": { "op": "ramp", "id": "$ground.id", "from": [0, -4, 1000], "to": [120, 40, 3400], "width": 150, "margin": 220 } },
    { "tool": "terrain_edit", "args": { "op": "auto_paint", "id": "$ground.id", "rock_slope": 0.1, "top_height": 900, "low_height": -1000 } },
    { "tool": "terrain_edit", "args": { "op": "paint_path", "id": "$ground.id", "layer": 2, "radius": 110, "strength": 1,
      "points": [[0, 860], [40, 1500], [-30, 2200], [60, 2900], [120, 3500]] } },
    { "tool": "blend", "args": { "op": "stroke", "ids": ["$ground.id"], "mode": "noise", "layer": 1, "radius": 520, "strength": 0.7, "noise_scale": 260,
      "points": [[-1800, -1200], [-1200, 1800], [1800, 2200], [2400, -1600]] } },
    { "tool": "blend", "args": { "op": "dab", "ids": ["$ground.id"], "mode": "smooth", "center": [0, 0, 1400], "radius": 700, "strength": 0.6 } },

    { "note": "Nave: arcades as rotated arch wall meshes, stained glass, gables, a slate roof and rafters repeated down the hall." },
    { "tool": "hierarchy", "args": { "op": "add_layer", "name": "Church" } },
    { "tool": "hierarchy", "args": { "op": "add_group", "name": "nave shell" } },
    { "tool": "create_brush", "args": { "min": [-272, -16, -592], "max": [272, 0, 592], "material": "showcase/church_tiles" } },
    { "tool": "create_brush", "args": { "min": [-272, 0, -592], "max": [-240, 136, 592], "material": "showcase/stone_bricks", "uv_scale": 0.5 } },
    { "tool": "create_brush", "args": { "min": [240, 0, -592], "max": [272, 136, 592], "material": "showcase/stone_bricks", "uv_scale": 0.5,
      "openings": [[[239, 0, -40], [273, 120, 40]]] } },
    { "tool": "create_brush", "args": { "min": [-272, 136, -592], "max": [-240, 400, -500], "material": "showcase/stone_bricks", "uv_scale": 0.5 }, "save": "pier" },
    { "tool": "duplicate", "args": { "ids": ["$pier.ids.0"], "offset": [512, 0, 0] } },
    { "tool": "duplicate", "args": { "ids": ["$pier.ids.0"], "offset": [0, 0, 1092] } },
    { "tool": "duplicate", "args": { "ids": ["$pier.ids.0"], "offset": [512, 0, 1092] } },
    { "tool": "create_mesh", "args": { "shape": "arch_wall", "min": [-100, 0, -16], "max": [100, 264, 16], "opening_width": 72, "opening_height": 194, "sides": 12,
      "material": "showcase/stone_bricks", "rotate_y": 90, "translate": [-256, 136, -400], "uv_scale": 0.5 }, "save": "arch_west" },
    { "tool": "duplicate", "args": { "ids": ["$arch_west.id"], "offset": [0, 0, 200], "count": 4 } },
    { "tool": "create_mesh", "args": { "shape": "arch_wall", "min": [-100, 0, -16], "max": [100, 264, 16], "opening_width": 72, "opening_height": 194, "sides": 12,
      "material": "showcase/stone_bricks", "rotate_y": 90, "translate": [256, 136, -400], "uv_scale": 0.5 }, "save": "arch_east" },
    { "tool": "duplicate", "args": { "ids": ["$arch_east.id"], "offset": [0, 0, 200], "count": 4 } },
    { "tool": "create_brush", "args": { "min": [-258, 136, -436], "max": [-254, 330, -364], "material": "showcase/stained_glass" }, "save": "glass_west" },
    { "tool": "duplicate", "args": { "ids": ["$glass_west.ids.0"], "offset": [0, 0, 200], "count": 4 } },
    { "tool": "create_brush", "args": { "min": [254, 136, -436], "max": [258, 330, -364], "material": "showcase/stained_glass" }, "save": "glass_east" },
    { "tool": "duplicate", "args": { "ids": ["$glass_east.ids.0"], "offset": [0, 0, 200], "count": 4 } },
    { "tool": "create_mesh", "args": { "shape": "arch_wall", "min": [-272, 0, 560], "max": [272, 400, 592], "opening_width": 144, "opening_height": 240, "sides": 12,
      "material": "showcase/stone_bricks", "uv_scale": 0.5 } },
    { "tool": "create_brush", "args": { "min": [-272, 0, -592], "max": [272, 160, -560], "material": "showcase/stone_bricks", "uv_scale": 0.5 } },
    { "tool": "create_mesh", "args": { "shape": "arch_wall", "min": [-272, 160, -592], "max": [272, 400, -560], "opening_width": 96, "opening_height": 200, "sides": 12,
      "material": "showcase/stone_bricks", "uv_scale": 0.5 } },
    { "tool": "create_brush", "args": { "min": [-48, 160, -578], "max": [48, 360, -574], "material": "showcase/stained_glass" } },
    { "tool": "create_brush", "args": { "shape": "gable", "min": [-272, 400, -592], "max": [272, 560, -560], "material": "showcase/stone_bricks", "uv_scale": 0.5 }, "save": "gable" },
    { "tool": "duplicate", "args": { "ids": ["$gable.ids.0"], "offset": [0, 0, 1152] } },
    { "tool": "create_mesh", "args": { "shape": "gable_roof", "min": [-272, 400, -592], "max": [272, 576, 592], "ridge_z": true, "thickness": 16, "overhang": 40,
      "material": "showcase/roof_slate", "uv_scale": 1 } },
    { "tool": "create_brush", "args": { "min": [-240, 376, -510], "max": [240, 396, -490], "material": "showcase/beam" }, "save": "tie" },
    { "tool": "create_brush", "args": { "min": [-240, 389, -507], "max": [40, 403, -493], "material": "showcase/beam" }, "save": "rafter_l" },
    { "tool": "transform", "args": { "rotate": { "axis": "z", "degrees": 31, "center": [-240, 396, -500] } } },
    { "tool": "create_brush", "args": { "min": [-40, 389, -507], "max": [240, 403, -493], "material": "showcase/beam" }, "save": "rafter_r" },
    { "tool": "transform", "args": { "rotate": { "axis": "z", "degrees": -31, "center": [240, 396, -500] } } },
    { "tool": "duplicate", "args": { "ids": ["$tie.ids.0", "$rafter_l.ids.0", "$rafter_r.ids.0"], "offset": [0, 0, 200], "count": 5 } },
    { "tool": "hierarchy", "args": { "op": "close_group" } },

    { "note": "One pew row as a group, then ten linked copies: editing any row updates all of them." },
    { "tool": "hierarchy", "args": { "op": "add_group", "name": "pew row" }, "save": "pews" },
    { "tool": "create_brush", "args": { "min": [-208, 24, -300], "max": [-48, 30, -272], "material": "showcase/planks_dark" }, "save": "seat" },
    { "tool": "create_brush", "args": { "min": [-208, 30, -274], "max": [-48, 64, -270], "material": "showcase/planks_dark" }, "save": "backrest" },
    { "tool": "create_brush", "args": { "min": [-208, 0, -300], "max": [-204, 60, -270], "material": "showcase/beam" }, "save": "pew_end" },
    { "tool": "duplicate", "args": { "ids": ["$pew_end.ids.0"], "offset": [156, 0, 0] }, "save": "pew_end2" },
    { "tool": "duplicate", "args": { "ids": ["$seat.ids.0", "$backrest.ids.0", "$pew_end.ids.0", "$pew_end2.copies.0.0"], "offset": [256, 0, 0] } },
    { "tool": "hierarchy", "args": { "op": "close_group" } },
    { "tool": "duplicate", "args": { "ids": ["$pews.id"], "offset": [0, 0, 72], "count": 10, "linked": true } },

    { "note": "Chancel, candles, organ pipes and three linked chandeliers." },
    { "tool": "hierarchy", "args": { "op": "add_group", "name": "chancel" } },
    { "tool": "create_brush", "args": { "min": [-240, 0, -560], "max": [240, 24, -400], "material": "showcase/planks" } },
    { "tool": "create_brush", "args": { "min": [-240, 0, -400], "max": [240, 12, -384], "material": "showcase/planks" } },
    { "tool": "create_brush", "args": { "min": [-64, 24, -500], "max": [64, 68, -460], "material": "showcase/white_paint" } },
    { "tool": "create_brush", "args": { "min": [-68, 68, -504], "max": [68, 72, -456], "material": "showcase/gold" } },
    { "tool": "create_brush", "args": { "min": [-8, 200, -560], "max": [8, 330, -552], "material": "showcase/gold" } },
    { "tool": "create_brush", "args": { "min": [-48, 280, -560], "max": [48, 296, -552], "material": "showcase/gold" } },
    { "tool": "create_brush", "args": { "min": [-32, 0, -400], "max": [32, 2, 540], "material": "showcase/carpet" } },
    { "tool": "create_mesh", "args": { "shape": "lathe", "center": [-40, 0, -480], "profile": [[3, 72], [3, 90]], "sides": 8, "material": "showcase/plaster", "smooth_angle": 40 }, "save": "candle" },
    { "tool": "create_mesh", "args": { "shape": "lathe", "center": [-40, 0, -480], "profile": [[1.5, 90], [0, 96]], "sides": 6, "material": "showcase/lamp", "smooth_angle": 40 }, "save": "flame" },
    { "tool": "create_entity", "args": { "classname": "light", "origin": [-40, 100, -480], "properties": { "light_energy": "0.8", "light_color": "255 190 110", "omni_range": "5" } }, "save": "candle_light" },
    { "tool": "duplicate", "args": { "ids": ["$candle.id", "$flame.id", "$candle_light.id"], "offset": [80, 0, 0] } },
    { "tool": "create_brush", "args": { "min": [140, 24, -430], "max": [164, 72, -414], "material": "showcase/planks_dark" } },
    { "tool": "create_brush", "args": { "min": [136, 72, -436], "max": [168, 76, -408], "material": "showcase/planks_dark" } },
    { "tool": "create_mesh", "args": { "shape": "lathe", "center": [-220, 0, -540], "profile": [[6, 24], [6, 162], [0, 168]], "sides": 10, "material": "showcase/gold", "smooth_angle": 45 } },
    { "tool": "create_mesh", "args": { "shape": "lathe", "center": [-206, 0, -540], "profile": [[6, 24], [6, 174], [0, 180]], "sides": 10, "material": "showcase/gold", "smooth_angle": 45 } },
    { "tool": "create_mesh", "args": { "shape": "lathe", "center": [-192, 0, -540], "profile": [[6, 24], [6, 186], [0, 192]], "sides": 10, "material": "showcase/gold", "smooth_angle": 45 } },
    { "tool": "create_mesh", "args": { "shape": "lathe", "center": [-178, 0, -540], "profile": [[6, 24], [6, 198], [0, 204]], "sides": 10, "material": "showcase/gold", "smooth_angle": 45 } },
    { "tool": "create_mesh", "args": { "shape": "lathe", "center": [-164, 0, -540], "profile": [[6, 24], [6, 198], [0, 204]], "sides": 10, "material": "showcase/gold", "smooth_angle": 45 } },
    { "tool": "create_mesh", "args": { "shape": "lathe", "center": [-150, 0, -540], "profile": [[6, 24], [6, 186], [0, 192]], "sides": 10, "material": "showcase/gold", "smooth_angle": 45 } },
    { "tool": "create_mesh", "args": { "shape": "lathe", "center": [-136, 0, -540], "profile": [[6, 24], [6, 174], [0, 180]], "sides": 10, "material": "showcase/gold", "smooth_angle": 45 } },
    { "tool": "create_mesh", "args": { "shape": "lathe", "center": [-122, 0, -540], "profile": [[6, 24], [6, 162], [0, 168]], "sides": 10, "material": "showcase/gold", "smooth_angle": 45 } },
    { "tool": "hierarchy", "args": { "op": "close_group" } },
    { "tool": "hierarchy", "args": { "op": "add_group", "name": "chandelier" }, "save": "chandelier" },
    { "tool": "create_mesh", "args": { "shape": "torus", "min": [-51, 297, -251], "max": [51, 303, -149], "thickness": 3, "sides": 20, "material": "showcase/gold", "smooth_angle": 50 } },
    { "tool": "create_mesh", "args": { "shape": "lathe", "center": [0, 0, -200], "profile": [[1.5, 300], [1.5, 376]], "sides": 6, "material": "showcase/metal" } },
    { "tool": "create_mesh", "args": { "shape": "lathe", "center": [48, 0, -200], "profile": [[2, 302], [2, 314], [0, 318]], "sides": 6, "material": "showcase/lamp", "smooth_angle": 40 }, "save": "arm_candle" },
    { "tool": "duplicate", "args": { "ids": ["$arm_candle.id"], "offset": [0, 0, 0], "rotate_y": 60, "pivot": [0, 300, -200], "count": 5 } },
    { "tool": "create_entity", "args": { "classname": "light", "origin": [0, 290, -200], "properties": { "light_energy": "1.5", "light_color": "255 210 150", "omni_range": "13" } } },
    { "tool": "hierarchy", "args": { "op": "close_group" } },
    { "tool": "duplicate", "args": { "ids": ["$chandelier.id"], "offset": [0, 0, 300], "count": 2, "linked": true } },
    { "tool": "hierarchy", "args": { "op": "close_group", "all": true } },

    { "note": "Bell tower with a narthex: a hollowed box with the door carved out, open belfry arches, a spire and a bell. The double doors open together from one trigger." },
    { "tool": "hierarchy", "args": { "op": "add_group", "name": "bell tower" } },
    { "tool": "create_brush", "args": { "min": [-112, -16, 592], "max": [112, 480, 816], "material": "showcase/stone_bricks", "uv_scale": 0.5, "hollow": 16,
      "openings": [[[-40, 0, 790], [40, 128, 830]], [[-72, 0, 560], [72, 240, 620]]] } },
    { "tool": "create_mesh", "args": { "shape": "arch_wall", "min": [-112, 480, 592], "max": [112, 640, 608], "opening_width": 72, "opening_height": 120, "sides": 10, "material": "showcase/stone_bricks", "uv_scale": 0.5 } },
    { "tool": "create_mesh", "args": { "shape": "arch_wall", "min": [-112, 480, 800], "max": [112, 640, 816], "opening_width": 72, "opening_height": 120, "sides": 10, "material": "showcase/stone_bricks", "uv_scale": 0.5 } },
    { "tool": "create_mesh", "args": { "shape": "arch_wall", "min": [-112, 0, -8], "max": [112, 160, 8], "opening_width": 72, "opening_height": 120, "sides": 10, "material": "showcase/stone_bricks",
      "rotate_y": 90, "translate": [-104, 480, 704], "uv_scale": 0.5 }, "save": "belfry_side" },
    { "tool": "duplicate", "args": { "ids": ["$belfry_side.id"], "offset": [208, 0, 0] } },
    { "tool": "create_brush", "args": { "min": [-124, 640, 580], "max": [124, 656, 828], "material": "showcase/stone_bricks", "uv_scale": 0.5 } },
    { "tool": "create_mesh", "args": { "shape": "spire", "min": [-112, 656, 592], "max": [112, 980, 816], "sides": 4, "material": "showcase/roof_slate", "uv_scale": 1 } },
    { "tool": "create_mesh", "args": { "shape": "lathe", "center": [0, 0, 704], "profile": [[3, 980], [3, 1040]], "sides": 8, "material": "showcase/gold", "smooth_angle": 50 } },
    { "tool": "create_brush", "args": { "min": [-20, 1016, 702], "max": [20, 1022, 706], "material": "showcase/gold" } },
    { "tool": "create_mesh", "args": { "shape": "lathe", "center": [0, 0, 704], "profile": [[0, 520], [40, 520], [34, 536], [26, 570], [22, 590], [0, 596]], "sides": 20, "caps": false, "material": "showcase/gold", "smooth_angle": 50 } },
    { "tool": "create_brush", "args": { "min": [-48, 596, 700], "max": [48, 606, 708], "material": "showcase/beam" } },
    { "tool": "create_entity", "args": { "classname": "light", "origin": [0, 200, 704], "properties": { "light_energy": "1.2", "light_color": "255 220 170", "omni_range": "9" } } },
    { "tool": "create_brush", "args": { "min": [-40, 0, 804], "max": [0, 126, 810], "material": "showcase/planks_dark" }, "save": "leaf_l" },
    { "tool": "gameplay", "args": { "op": "make_door", "ids": ["$leaf_l.ids.0"], "kind": "hinged", "side": "left", "angle": 105, "properties": { "targetname": "church_door_l", "wait": "6" } } },
    { "tool": "create_brush", "args": { "min": [0, 0, 804], "max": [40, 126, 810], "material": "showcase/planks_dark" }, "save": "leaf_r" },
    { "tool": "gameplay", "args": { "op": "make_door", "ids": ["$leaf_r.ids.0"], "kind": "hinged", "side": "right", "angle": 105, "properties": { "targetname": "church_door_r", "wait": "6" } } },
    { "tool": "gameplay", "args": { "op": "volume", "classname": "trigger_multiple", "min": [-80, 8, 830], "max": [80, 120, 930], "properties": { "targetname": "church_porch" },
      "outputs": [
        { "output": "entered", "target": "church_door_*", "input": "open", "parameter": "" },
        { "output": "entered", "target": "bell_log", "input": "write", "parameter": "Someone enters the church" }
      ] } },
    { "tool": "gameplay", "args": { "op": "place", "classname": "logic_debug", "origin": [0, 700, 704], "properties": { "targetname": "bell_log", "message": "Bell tower: {parameter}" } } },
    { "tool": "gameplay", "args": { "op": "place", "classname": "logic_timer", "origin": [0, 560, 704], "properties": { "targetname": "bell_timer", "interval": "30" },
      "outputs": [{ "output": "timer", "target": "bell_log", "input": "write", "parameter": "the bell rings" }] } },
    { "tool": "hierarchy", "args": { "op": "close_group", "all": true } },

    { "note": "School wing: a cloister corridor and a classroom carved from hollowed boxes. Three chalkboard buttons count up and open the courtyard gate." },
    { "tool": "hierarchy", "args": { "op": "add_layer", "name": "School" } },
    { "tool": "hierarchy", "args": { "op": "add_group", "name": "cloister" } },
    { "tool": "create_brush", "args": { "min": [272, 0, -72], "max": [456, 176, -56], "material": "showcase/plaster",
      "openings": [[[296, 64, -80], [344, 136, -48]], [[376, 64, -80], [424, 136, -48]]] }, "save": "cloister_wall" },
    { "tool": "create_brush", "args": { "min": [272, 0, 56], "max": [456, 176, 72], "material": "showcase/plaster",
      "openings": [[[296, 64, 48], [344, 136, 80]], [[376, 64, 48], [424, 136, 80]]] } },
    { "tool": "create_brush", "args": { "min": [272, -16, -72], "max": [456, 0, 72], "material": "showcase/church_tiles" } },
    { "tool": "create_brush", "args": { "min": [264, 176, -88], "max": [464, 192, 88], "material": "showcase/planks_dark" } },
    { "tool": "create_entity", "args": { "classname": "light", "origin": [364, 150, 0], "properties": { "light_energy": "1.0", "light_color": "255 230 190", "omni_range": "8" } } },
    { "note": "A crate and a barrel stacked against the cloister wall, storage clutter by the school entrance." },
    { "tool": "create_entity", "args": { "classname": "prop_model", "origin": [300, -16, 10], "angles": [0, 20, 0], "properties": { "model": "res://models/polyhaven/containers/wooden_crate_01.gltf" } } },
    { "tool": "create_entity", "args": { "classname": "prop_model", "origin": [340, -16, -20], "angles": [0, -35, 0], "properties": { "model": "res://models/polyhaven/containers/wine_barrel_01.gltf" } } },
    { "tool": "hierarchy", "args": { "op": "close_group" } },
    { "tool": "hierarchy", "args": { "op": "add_group", "name": "classroom" } },
    { "tool": "create_brush", "args": { "min": [456, -24, -248], "max": [888, 224, 248], "material": "showcase/red_bricks", "hollow": 24,
      "openings": [
        [[450, 0, -40], [490, 112, 40]],
        [[860, 72, -150], [892, 176, -70]], [[860, 72, -40], [892, 176, 40]], [[860, 72, 70], [892, 176, 150]],
        [[560, 72, 220], [640, 176, 252]], [[704, 72, 220], [784, 176, 252]]
      ] } },
    { "tool": "create_brush", "args": { "min": [875, 72, -150], "max": [877, 176, -70], "material": "showcase/glass" }, "save": "pane_east" },
    { "tool": "duplicate", "args": { "ids": ["$pane_east.ids.0"], "offset": [0, 0, 110], "count": 2 } },
    { "tool": "create_brush", "args": { "min": [560, 72, 235], "max": [640, 176, 237], "material": "showcase/glass" }, "save": "pane_south" },
    { "tool": "duplicate", "args": { "ids": ["$pane_south.ids.0"], "offset": [144, 0, 0] } },
    { "tool": "create_mesh", "args": { "shape": "gable_roof", "min": [456, 224, -248], "max": [888, 336, 248], "ridge_z": true, "thickness": 12, "overhang": 28, "material": "showcase/roof_red", "uv_scale": 1 } },
    { "tool": "create_brush", "args": { "shape": "gable", "min": [456, 224, -248], "max": [888, 336, -224], "material": "showcase/red_bricks" }, "save": "school_gable" },
    { "tool": "duplicate", "args": { "ids": ["$school_gable.ids.0"], "offset": [0, 0, 472] } },
    { "tool": "create_brush", "args": { "min": [480, 0, -224], "max": [864, 1, 224], "material": "showcase/planks" } },
    { "tool": "create_brush", "args": { "min": [560, 64, -224], "max": [784, 160, -220], "material": "showcase/chalkboard" } },
    { "tool": "create_brush", "args": { "min": [556, 60, -224], "max": [788, 64, -214], "material": "showcase/planks_dark" } },
