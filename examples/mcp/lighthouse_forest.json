{
  "format": "godottrench-mcp-script",
  "vars": { "save_dir": "${project}/demo/maps/showcase" },
  "title": "Lighthouse and Forest",
  "description": "A striped lighthouse on a headland with a keeper's cottage, a walled compound with swinging gates, a boat on a path train, wisps spawning along the forest path and a trigger that calls a Godot method on the beacon. Built entirely from MCP tool calls.",
  "steps": [
    { "tool": "map_file", "args": { "op": "new" } },
    { "tool": "set_map_properties", "args": { "properties": {
      "message": "Lighthouse and Forest",
      "sun_angles": "-18 -120", "sun_color": "255 214 170", "sun_energy": "1.0", "ambient_color": "78 88 118",
      "sky_top_color": "58 104 178", "sky_horizon_color": "214 196 186", "sky_ground_color": "60 88 110",
      "fog_color": "200 196 200", "fog_density": "0.0004"
    } } },

    { "note": "Island terrain with a flattened headland for the compound and a ramp for the forest path. Sea level is y = 0." },
    { "tool": "hierarchy", "args": { "op": "add_layer", "name": "Island" } },
    { "tool": "create_terrain", "args": {
      "origin": [-4096, -160, -4096], "resolution": 129, "cell_size": 64, "shape": "island", "height": 760, "seed": 31, "feature_size": 1800, "erosion": 4,
      "auto_paint": false, "layers": [["showcase/grass", 384], ["showcase/rock", 256], ["showcase/dirt", 256], ["showcase/sand", 256]]
    }, "save": "island" },
    { "tool": "terrain_edit", "args": { "op": "flatten_rect", "id": "$island.id", "min": [1560, 560], "max": [2840, 1840], "height": 420, "margin": 520 } },
    { "tool": "terrain_edit", "args": { "op": "ramp", "id": "$island.id", "from": [160, 250, 1200], "to": [1580, 420, 1200], "width": 160, "margin": 260 } },
    { "tool": "terrain_edit", "args": { "op": "sculpt", "id": "$island.id", "mode": "smooth", "center": [900, 0, 1200], "radius": 700, "strength": 6 } },
    { "tool": "terrain_edit", "args": { "op": "auto_paint", "id": "$island.id", "rock_slope": 0.3, "top_height": 10000, "low_height": 40 } },
    { "tool": "terrain_edit", "args": { "op": "paint_path", "id": "$island.id", "layer": 2, "radius": 80, "strength": 1,
      "points": [[160, 1200], [480, 1290], [820, 1150], [1160, 1240], [1480, 1200], [1640, 1200]] } },
    { "tool": "blend", "args": { "op": "dab", "ids": ["$island.id"], "mode": "paint", "layer": 1, "center": [2200, 420, 1200], "radius": 540, "strength": 0.6, "falloff": "smooth" } },
    { "tool": "blend", "args": { "op": "dab", "ids": ["$island.id"], "mode": "noise", "layer": 1, "center": [2200, 420, 1200], "radius": 520, "strength": 0.5, "noise_scale": 90 } },
    { "tool": "create_mesh", "args": { "shape": "grid", "min": [-9000, 0, -9000], "max": [9000, 0, 9000], "divisions": 1, "material": "showcase/water", "uv_scale": 4 }, "save": "sea" },
    { "tool": "gameplay", "args": { "op": "brush_entity", "ids": ["$sea.id"], "classname": "func_illusionary" } },

    { "note": "Lighthouse: an octagonal plinth, eight lathe bands alternating white and red with the door and windows deleted, then solidified into walls." },
    { "tool": "hierarchy", "args": { "op": "add_layer", "name": "Lighthouse" } },
    { "tool": "hierarchy", "args": { "op": "add_group", "name": "tower" } },
    { "tool": "create_mesh", "args": { "shape": "prism", "footprint": [[2394, 1280], [2280, 1394], [2120, 1394], [2006, 1280], [2006, 1120], [2120, 1006], [2280, 1006], [2394, 1120]],
      "bottom": 360, "top": 452, "material": "showcase/stone_bricks", "uv_scale": 0.5 } },
    { "tool": "create_mesh", "args": { "shape": "lathe", "center": [2200, 0, 1200], "profile": [[136, 452], [132.75, 552]], "sides": 24, "caps": false, "material": "showcase/white_paint", "uv_scale": 1, "smooth_angle": 20 }, "save": "band0" },
    { "tool": "mesh_edit", "args": { "id": "$band0.id", "op": "delete_faces_in_box", "min": [2040, 440, 1175], "max": [2100, 560, 1225] } },
    { "tool": "mesh_edit", "args": { "id": "$band0.id", "op": "solidify", "thickness": 16 } },
    { "tool": "create_mesh", "args": { "shape": "lathe", "center": [2200, 0, 1200], "profile": [[132.75, 552], [129.5, 652]], "sides": 24, "caps": false, "material": "showcase/red_paint", "uv_scale": 1, "smooth_angle": 20 }, "save": "band1" },
    { "tool": "mesh_edit", "args": { "id": "$band1.id", "op": "solidify", "thickness": 16 } },
    { "tool": "create_mesh", "args": { "shape": "lathe", "center": [2200, 0, 1200], "profile": [[129.5, 652], [126.25, 752]], "sides": 24, "caps": false, "material": "showcase/white_paint", "uv_scale": 1, "smooth_angle": 20 }, "save": "band2" },
    { "tool": "mesh_edit", "args": { "id": "$band2.id", "op": "delete_faces_in_box", "min": [2300, 640, 1199], "max": [2360, 760, 1226] } },
    { "tool": "mesh_edit", "args": { "id": "$band2.id", "op": "solidify", "thickness": 16 } },
    { "tool": "create_mesh", "args": { "shape": "lathe", "center": [2200, 0, 1200], "profile": [[126.25, 752], [123, 852]], "sides": 24, "caps": false, "material": "showcase/red_paint", "uv_scale": 1, "smooth_angle": 20 }, "save": "band3" },
    { "tool": "mesh_edit", "args": { "id": "$band3.id", "op": "solidify", "thickness": 16 } },
    { "tool": "create_mesh", "args": { "shape": "lathe", "center": [2200, 0, 1200], "profile": [[123, 852], [119.75, 952]], "sides": 24, "caps": false, "material": "showcase/white_paint", "uv_scale": 1, "smooth_angle": 20 }, "save": "band4" },
    { "tool": "mesh_edit", "args": { "id": "$band4.id", "op": "delete_faces_in_box", "min": [2199, 840, 1040], "max": [2226, 960, 1110] } },
    { "tool": "mesh_edit", "args": { "id": "$band4.id", "op": "solidify", "thickness": 16 } },
    { "tool": "create_mesh", "args": { "shape": "lathe", "center": [2200, 0, 1200], "profile": [[119.75, 952], [116.5, 1052]], "sides": 24, "caps": false, "material": "showcase/red_paint", "uv_scale": 1, "smooth_angle": 20 }, "save": "band5" },
    { "tool": "mesh_edit", "args": { "id": "$band5.id", "op": "solidify", "thickness": 16 } },
    { "tool": "create_mesh", "args": { "shape": "lathe", "center": [2200, 0, 1200], "profile": [[116.5, 1052], [113.25, 1152]], "sides": 24, "caps": false, "material": "showcase/white_paint", "uv_scale": 1, "smooth_angle": 20 }, "save": "band6" },
    { "tool": "mesh_edit", "args": { "id": "$band6.id", "op": "delete_faces_in_box", "min": [2174, 1040, 1290], "max": [2201, 1160, 1340] } },
    { "tool": "mesh_edit", "args": { "id": "$band6.id", "op": "solidify", "thickness": 16 } },
    { "tool": "create_mesh", "args": { "shape": "lathe", "center": [2200, 0, 1200], "profile": [[113.25, 1152], [110, 1252]], "sides": 24, "caps": false, "material": "showcase/red_paint", "uv_scale": 1, "smooth_angle": 20 }, "save": "band7" },
    { "tool": "mesh_edit", "args": { "id": "$band7.id", "op": "solidify", "thickness": 16 } },
    { "tool": "create_mesh", "args": { "shape": "lathe", "center": [2200, 0, 1200], "profile": [[18, 452], [18, 1252]], "sides": 12, "material": "showcase/stone_bricks", "smooth_angle": 40 } },
    { "tool": "create_brush", "args": { "shape": "spiral_stairs", "min": [2112, 452, 1112], "max": [2288, 1236, 1288], "steps": 64, "thickness": 18, "turns": 3, "material": "showcase/planks" } },
    { "tool": "create_brush", "args": { "min": [2066, 452, 1168], "max": [2074, 552, 1232], "material": "showcase/planks_dark" }, "save": "tower_door" },
    { "tool": "gameplay", "args": { "op": "make_door", "ids": ["$tower_door.ids.0"], "kind": "sliding", "direction": "up", "lip": 6, "properties": { "targetname": "tower_door", "wait": "8" } } },
    { "tool": "create_entity", "args": { "classname": "light", "origin": [2200, 572, 1200], "properties": { "light_energy": "1.2", "light_color": "255 220 170", "omni_range": "8" } } },
    { "tool": "hierarchy", "args": { "op": "close_group" } },

    { "note": "Gallery, railing posts arrayed around the tower, lantern room with mullions, dome and the rotating beacon." },
    { "tool": "hierarchy", "args": { "op": "add_group", "name": "lantern" } },
    { "tool": "create_mesh", "args": { "shape": "lathe", "center": [2200, 0, 1200], "profile": [[0, 1252], [170, 1252], [170, 1268], [0, 1268]], "sides": 32, "caps": false, "material": "showcase/metal" } },
    { "tool": "create_mesh", "args": { "shape": "lathe", "center": [2360, 0, 1200], "profile": [[2, 1268], [2, 1312]], "sides": 6, "material": "showcase/metal" }, "save": "rail_post" },
    { "tool": "duplicate", "args": { "ids": ["$rail_post.id"], "offset": [0, 0, 0], "rotate_y": 12.857143, "pivot": [2200, 1268, 1200], "count": 27 } },
    { "tool": "create_mesh", "args": { "shape": "torus", "min": [2037, 1309, 1037], "max": [2363, 1315, 1363], "thickness": 3, "sides": 32, "material": "showcase/metal", "smooth_angle": 50 } },
    { "tool": "create_mesh", "args": { "shape": "lathe", "center": [2200, 0, 1200], "profile": [[80, 1268], [80, 1388]], "sides": 24, "caps": false, "material": "showcase/glass", "smooth_angle": 30 } },
    { "tool": "create_mesh", "args": { "shape": "lathe", "center": [2282, 0, 1200], "profile": [[4, 1268], [4, 1388]], "sides": 6, "material": "showcase/metal" }, "save": "mullion" },
    { "tool": "duplicate", "args": { "ids": ["$mullion.id"], "offset": [0, 0, 0], "rotate_y": 45, "pivot": [2200, 1268, 1200], "count": 7 } },
    { "tool": "create_mesh", "args": { "shape": "lathe", "center": [2200, 0, 1200],
      "profile": [[96, 1388], [92.7, 1408.7], [83.1, 1428], [67.9, 1444.6], [48, 1457.3], [24.8, 1465.3], [0, 1468]], "sides": 24, "material": "showcase/red_paint", "uv_scale": 1, "smooth_angle": 50 } },
    { "tool": "create_mesh", "args": { "shape": "cone", "min": [2190, 1464, 1190], "max": [2210, 1522, 1210], "sides": 8, "material": "showcase/gold" } },
    { "tool": "create_mesh", "args": { "shape": "sphere", "min": [2172, 1300, 1172], "max": [2228, 1356, 1228], "sides": 12, "material": "showcase/lamp", "smooth_angle": 60 } },
    { "tool": "create_entity", "args": { "classname": "light_rotating", "origin": [2200, 1328, 1200],
      "properties": { "targetname": "beacon", "light_energy": "12", "spot_range": "160", "spot_angle": "10", "degrees_per_second": "45" } } },
    { "tool": "create_entity", "args": { "classname": "light", "origin": [2200, 1328, 1200], "properties": { "light_energy": "3", "light_color": "255 240 190", "omni_range": "14" } } },
    { "note": "trigger_call runs a plain Godot method with arguments: Light3D.set_param(PARAM_ENERGY, 30) on the beacon when you reach the top of the stairs." },
    { "tool": "gameplay", "args": { "op": "volume", "classname": "trigger_call", "min": [2120, 1140, 1120], "max": [2280, 1240, 1280],
      "properties": { "targetname": "stair_top", "call_target": "beacon", "method": "set_param", "arguments": "[0, 30]", "once": "1" },
      "outputs": [{ "output": "called", "target": "keeper_log", "input": "write", "parameter": "The beacon flares up" }] } },
    { "tool": "hierarchy", "args": { "op": "close_group", "all": true } },

    { "note": "Keeper cottage: one hollowed box with the door and two windows carved out, gables, roof, stove and simple furniture." },
    { "tool": "hierarchy", "args": { "op": "add_group", "name": "keeper cottage" } },
    { "tool": "create_brush", "args": { "min": [2426, 380, 1056], "max": [2730, 404, 1344], "material": "showcase/cobble" } },
    { "tool": "create_brush", "args": { "min": [2434, 404, 1064], "max": [2722, 580, 1336], "material": "showcase/white_paint", "hollow": 16,
      "openings": [[[2428, 420, 1168], [2456, 524, 1232]], [[2700, 468, 1120], [2728, 532, 1184]], [[2530, 468, 1314], [2610, 532, 1342]]] } },
    { "tool": "create_brush", "args": { "min": [2713, 468, 1120], "max": [2715, 532, 1184], "material": "showcase/glass" } },
    { "tool": "create_brush", "args": { "min": [2530, 468, 1327], "max": [2610, 532, 1329], "material": "showcase/glass" } },
    { "tool": "create_brush", "args": { "shape": "gable", "ridge_x": true, "min": [2434, 580, 1064], "max": [2450, 670, 1336], "material": "showcase/white_paint" }, "save": "cottage_gable" },
    { "tool": "duplicate", "args": { "ids": ["$cottage_gable.ids.0"], "offset": [272, 0, 0] } },
    { "tool": "create_mesh", "args": { "shape": "gable_roof", "min": [2434, 580, 1064], "max": [2722, 670, 1336], "thickness": 10, "overhang": 24, "material": "showcase/roof_red", "uv_scale": 1 } },
    { "tool": "create_brush", "args": { "min": [2450, 420, 1080], "max": [2706, 422, 1320], "material": "showcase/planks" } },
    { "tool": "create_brush", "args": { "min": [2570, 448, 1100], "max": [2650, 452, 1160], "material": "showcase/planks" } },
    { "tool": "create_brush", "args": { "min": [2574, 422, 1104], "max": [2646, 448, 1108], "material": "showcase/planks_dark" } },
    { "tool": "create_brush", "args": { "min": [2606, 422, 1230], "max": [2702, 440, 1316], "material": "showcase/planks_dark" } },
    { "tool": "create_brush", "args": { "min": [2610, 440, 1234], "max": [2698, 448, 1312], "material": "showcase/plaster" } },
    { "tool": "create_mesh", "args": { "shape": "lathe", "center": [2490, 0, 1280], "profile": [[22, 422], [22, 472], [8, 478], [8, 670]], "sides": 12, "material": "showcase/metal", "smooth_angle": 40 } },
    { "tool": "create_brush", "args": { "min": [2438, 422, 1168], "max": [2446, 524, 1232], "material": "showcase/planks_dark" }, "save": "cottage_door" },
    { "tool": "gameplay", "args": { "op": "make_door", "ids": ["$cottage_door.ids.0"], "kind": "hinged", "side": "left", "angle": 100, "trigger": true, "properties": { "targetname": "cottage_door", "wait": "5" } } },
    { "tool": "create_entity", "args": { "classname": "light", "origin": [2578, 550, 1200], "properties": { "light_energy": "1.4", "light_color": "255 220 170", "omni_range": "9" } } },
    { "tool": "gameplay", "args": { "op": "place", "classname": "logic_debug", "origin": [2578, 520, 1260], "properties": { "targetname": "keeper_log", "message": "Keeper: {parameter}" } } },
    { "tool": "hierarchy", "args": { "op": "close_group", "all": true } },

    { "note": "Compound wall: one rotated segment arrayed 25 times around the tower, leaving a gap on the west side for the gates." },
    { "tool": "hierarchy", "args": { "op": "add_group", "name": "compound wall and gates" } },
    { "tool": "create_brush", "args": { "min": [2743.2, 380, 1134.2], "max": [2771.2, 500, 1265.8], "material": "showcase/stone_bricks", "uv_scale": 0.5 }, "save": "wall_segment" },
    { "tool": "transform", "args": { "rotate": { "axis": "y", "degrees": 160.714286, "center": [2200, 440, 1200] } } },
    { "tool": "duplicate", "args": { "ids": ["$wall_segment.ids.0"], "offset": [0, 0, 0], "rotate_y": -12.857143, "pivot": [2200, 440, 1200], "count": 25 } },
    { "tool": "create_brush", "args": { "min": [1616, 380, 1117.2], "max": [1664, 556, 1137.2], "material": "showcase/stone_bricks", "uv_scale": 0.5 }, "save": "gate_post" },
    { "tool": "create_mesh", "args": { "shape": "sphere", "min": [1622, 556, 1109.2], "max": [1658, 592, 1145.2], "sides": 10, "material": "showcase/stone_bricks" }, "save": "post_cap" },
    { "tool": "duplicate", "args": { "ids": ["$gate_post.ids.0", "$post_cap.id"], "offset": [0, 0, 145.6] } },
    { "tool": "create_brush", "args": { "min": [1637, 420, 1137.2], "max": [1643, 538, 1200], "material": "showcase/iron_bars", "uv_scale": 0.5 }, "save": "gate_l" },
    { "tool": "gameplay", "args": { "op": "make_door", "ids": ["$gate_l.ids.0"], "kind": "hinged", "side": "left", "angle": 100, "properties": { "targetname": "gate_left", "open_away": "0" } } },
    { "tool": "create_brush", "args": { "min": [1637, 420, 1200], "max": [1643, 538, 1262.8], "material": "showcase/iron_bars", "uv_scale": 0.5 }, "save": "gate_r" },
    { "tool": "gameplay", "args": { "op": "make_door", "ids": ["$gate_r.ids.0"], "kind": "hinged", "side": "right", "angle": 100, "properties": { "targetname": "gate_right", "open_away": "0" } } },
    { "note": "One sensor fires a relay, the relay opens both leaves and later the tower door." },
    { "tool": "gameplay", "args": { "op": "volume", "classname": "trigger_multiple", "min": [1380, 340, 1097], "max": [1600, 540, 1303], "properties": { "targetname": "gate_sensor" },
      "outputs": [{ "output": "entered", "target": "gate_relay", "input": "trigger" }] } },
    { "tool": "gameplay", "args": { "op": "place", "classname": "logic_relay", "origin": [1560, 600, 1200], "properties": { "targetname": "gate_relay" },
      "outputs": [
        { "output": "triggered", "target": "gate_left", "input": "open" },
        { "output": "triggered", "target": "gate_right", "input": "open", "delay": 0.15 },
        { "output": "triggered", "target": "tower_door", "input": "open", "delay": 2 },
        { "output": "triggered", "target": "keeper_log", "input": "write", "parameter": "Visitor at the gate" }
      ] } },
    { "tool": "create_mesh", "args": { "shape": "lathe", "center": [1580, 0, 1097], "profile": [[3, 360], [3, 560]], "sides": 8, "material": "showcase/metal" }, "save": "lamp_pole" },
    { "tool": "create_mesh", "args": { "shape": "sphere", "min": [1570, 560, 1087], "max": [1590, 580, 1107], "sides": 8, "material": "showcase/lamp" }, "save": "lamp_globe" },
    { "tool": "create_entity", "args": { "classname": "light", "origin": [1580, 570, 1097], "properties": { "light_energy": "1.0", "light_color": "255 210 140", "omni_range": "7" } }, "save": "lamp_light" },
    { "tool": "duplicate", "args": { "ids": ["$lamp_pole.id", "$lamp_globe.id", "$lamp_light.id"], "offset": [0, 0, 206] } },
    { "tool": "hierarchy", "args": { "op": "close_group", "all": true } },

    { "note": "Gameplay: a boat sailing a loop of path corners, wisps spawning along the forest path." },
    { "tool": "hierarchy", "args": { "op": "add_layer", "name": "Gameplay" } },
    { "tool": "create_entity", "args": { "classname": "info_player_start", "origin": [260, 272, 1200], "angles": [0, -90, 0] } },
    { "tool": "create_entity", "args": { "classname": "path_corner", "origin": [4300, 12, -200], "properties": { "targetname": "sea_1", "target": "sea_2", "wait": "2" } } },
    { "tool": "create_entity", "args": { "classname": "path_corner", "origin": [4800, 12, 1200], "properties": { "targetname": "sea_2", "target": "sea_3" } } },
    { "tool": "create_entity", "args": { "classname": "path_corner", "origin": [4300, 12, 2600], "properties": { "targetname": "sea_3", "target": "sea_4", "wait": "2" } } },
    { "tool": "create_entity", "args": { "classname": "path_corner", "origin": [3900, 12, 1200], "properties": { "targetname": "sea_4", "target": "sea_1" } } },
    { "tool": "hierarchy", "args": { "op": "add_group", "name": "boat" } },
    { "tool": "create_brush", "args": { "min": [4240, -8, -224], "max": [4360, 16, -176], "material": "showcase/planks_dark" }, "save": "hull" },
    { "tool": "create_brush", "args": { "shape": "wedge", "min": [4360, -8, -224], "max": [4400, 16, -176], "material": "showcase/planks_dark" }, "save": "bow" },
    { "tool": "create_brush", "args": { "min": [4296, 16, -202], "max": [4302, 110, -198], "material": "showcase/beam" }, "save": "mast" },
    { "tool": "create_brush", "args": { "min": [4262, 36, -201], "max": [4296, 104, -199], "material": "showcase/plaster" }, "save": "sail" },
    { "tool": "gameplay", "args": { "op": "brush_entity", "ids": ["$hull.ids.0", "$bow.ids.0", "$mast.ids.0", "$sail.ids.0"], "classname": "func_train",
      "properties": { "targetname": "boat", "target": "sea_1", "speed": "4", "loop": "1", "orient": "1" } } },
    { "tool": "hierarchy", "args": { "op": "close_group" } },
    { "tool": "gameplay", "args": { "op": "volume", "classname": "trigger_spawn_area", "min": [640, 250, 1020], "max": [1040, 520, 1380],
      "properties": { "targetname": "wisp_area", "scene": "res://demo/scenes/wisp.tscn", "count": "3", "max_alive": "6", "total": "12", "spawn_group": "wisps" },
      "outputs": [
        { "output": "spawned", "target": "keeper_log", "input": "write", "parameter": "wisps drift out of the forest" },
        { "output": "exhausted", "target": "keeper_log", "input": "write", "parameter": "the forest is quiet again" }
      ] } },

    { "note": "Forest, undergrowth and shore rocks, kept out of the compound and off the path." },
    { "tool": "scatter", "args": { "op": "install_models" } },
    { "tool": "scatter", "args": { "op": "new_set", "name": "island forest", "targets": ["$island.id"], "preset": "forest" }, "save": "forest" },
    { "tool": "scatter", "args": { "op": "fill", "id": "$forest.id", "density": 0.24, "slope": [0, 22], "height": [90, 2000], "seed": 33 } },
    { "tool": "scatter", "args": { "op": "erase", "id": "$forest.id", "center": [2200, 420, 1200], "radius": 820 } },
    { "tool": "scatter", "args": { "op": "stroke", "id": "$forest.id", "erase": true, "radius": 220, "points": [[140, 1200], [480, 1290], [820, 1150], [1160, 1240], [1600, 1200]] } },
    { "tool": "scatter", "args": { "op": "new_set", "name": "undergrowth", "targets": ["$island.id"], "preset": "undergrowth" }, "save": "brush" },
    { "tool": "scatter", "args": { "op": "fill", "id": "$brush.id", "density": 0.1, "slope": [0, 28], "height": [50, 2000], "seed": 34 } },
    { "tool": "scatter", "args": { "op": "erase", "id": "$brush.id", "center": [2200, 420, 1200], "radius": 700 } },
    { "tool": "scatter", "args": { "op": "stroke", "id": "$brush.id", "erase": true, "radius": 120, "points": [[140, 1200], [480, 1290], [820, 1150], [1160, 1240], [1600, 1200]] } },
    { "tool": "scatter", "args": { "op": "new_set", "name": "shore rocks", "targets": ["$island.id"], "preset": "rocks" }, "save": "rocks" },
    { "tool": "scatter", "args": { "op": "fill", "id": "$rocks.id", "density": 0.06, "height": [-60, 70], "seed": 35 } },

    { "tool": "set_camera", "args": { "view": "3d", "position": [4300, 900, 3300], "look_at": [2200, 700, 1200] } },
    { "tool": "run_action", "args": { "action": "store_camera", "args": { "slot": 1 } } },
    { "tool": "set_camera", "args": { "view": "3d", "position": [1200, 740, 1620], "look_at": [1640, 480, 1200] } },
    { "tool": "run_action", "args": { "action": "store_camera", "args": { "slot": 2 } } },
    { "tool": "set_camera", "args": { "view": "3d", "position": [-1500, 1300, -2200], "look_at": [700, 300, 600] } },
    { "tool": "run_action", "args": { "action": "store_camera", "args": { "slot": 3 } } },
    { "tool": "run_action", "args": { "action": "select_none" } },
    { "tool": "map_file", "args": { "op": "save", "path": "${save_dir}/lighthouse_forest.gtm" } }
  ]
}
