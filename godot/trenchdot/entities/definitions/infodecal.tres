class_property_descriptions = Dictionary[String, Variant]({
"material": "Material to project, named like a face's (base/stain) or a res:// path. Its textures, color and texture_size are used",
"texture": "res:// path of an albedo texture, used when material is empty",
"normal_texture": "res:// path of a normal map. A material's own normal map replaces it",
"size": "Width, depth and height in map units, depth being how far it reaches into the surface. Left at 64 32 64, a material's texture_size sets width and height",
"modulate": "Tints the decal, white keeps its colors"
})
