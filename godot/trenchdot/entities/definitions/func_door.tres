"targetname": "Name other entities use to open it",
"travel": "Offset the door slides by, in map units",
"speed": "Meters per second",
"wait": "Seconds before it closes again, -1 stays open",
"locked": "Ignores open and use until unlocked",
"start_open": "Starts in the open position",
"interact": "Opens when a player calls use() on it",
"collision": ["Collision shape. default keeps the class shape, a convex hull per brush. box is one box around all brushes, convex decomposition builds a hull per brush, trimesh follows every face and only works on static bodies such as doors and lifts", "default"],
"collision_layer": "Physics layers the body is on, as layer numbers such as 1, 3. Empty keeps the class default, none puts it on no layer",
