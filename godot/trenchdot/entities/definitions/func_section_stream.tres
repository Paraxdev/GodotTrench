[resource]
script = ExtResource("1_class")
classname = "func_section_stream"
description = "One half of a connector room between two streamed sections. While the player stands in it, TDSectionStreamer loads the section it names, swapping sections around the shared info_landmark. Give a connector two, one per side, meeting where neither end of the room can be seen."
build_visuals = false
collision_shape_type = 1
script_class = ExtResource("2_script")
class_properties = Dictionary[String, Variant]({
"section": "",
"landmark": "",
"collision": {
"default": "default",
"none": "none",
"box": "box",
"convex hull": "convex",
"convex decomposition": "decomposition",
"trimesh": "trimesh"
},
"collision_layer": "",
"collision_mask": ""
})
class_property_descriptions = Dictionary[String, Variant]({
"section": "The section on this side: its scene path, or a name found in the streamer's sections folder",
"landmark": "Name of the info_landmark in this connector",
"collision": ["Collision shape. default keeps the class shape, a convex hull per brush. box is one box around all brushes, convex decomposition builds a hull per brush, trimesh follows every face and only works on static bodies such as doors and lifts", "default"],
"collision_layer": "Physics layers the body is on, as layer numbers such as 1, 3. Empty keeps the class default, none puts it on no layer",
"collision_mask": "Physics layers the body detects, as layer numbers such as 1, 3. Empty keeps the class default, none detects nothing"
})
meta_properties = Dictionary[String, Variant]({
"color": Color(0.3019608, 0.9019608, 0.8, 1)
})
