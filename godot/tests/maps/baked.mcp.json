{
  "format": "godottrench-mcp-script",
  "vars": { "save_dir": "${project}/tests/maps" },
  "steps": [
    { "note": "Test map for godot/tests/lightmap_tests.gd: a closed room with one lamp, baked at preview quality. Replay it with run_script to regenerate baked.gtm." },
    { "tool": "map_file", "args": { "op": "new" } },
    { "tool": "set_map_properties", "args": { "properties": { "message": "Baked Room", "sun_energy": "0", "ambient_energy": "0.2", "sky_energy": "0.2" } } },
    { "tool": "create_brush", "args": { "min": [-192, -16, -192], "max": [192, 0, 192], "material": "showcase/cobble" } },
    { "tool": "create_brush", "args": { "min": [-192, 160, -192], "max": [192, 176, 192], "material": "showcase/planks_dark" } },
    { "tool": "create_brush", "args": { "min": [-208, 0, -192], "max": [-192, 160, 192], "material": "showcase/stone_bricks" } },
    { "tool": "create_brush", "args": { "min": [192, 0, -192], "max": [208, 160, 192], "material": "showcase/stone_bricks" } },
    { "tool": "create_brush", "args": { "min": [-192, 0, -208], "max": [192, 160, -192], "material": "showcase/stone_bricks" } },
    { "tool": "create_brush", "args": { "min": [-192, 0, 192], "max": [192, 160, 208], "material": "showcase/stone_bricks" } },
    { "tool": "create_brush", "args": { "min": [-32, 0, -32], "max": [32, 48, 32], "material": "showcase/cobble" } },
    { "tool": "create_entity", "args": { "classname": "light", "origin": [-96, 120, 0], "properties": { "light_energy": "2", "omni_range": "10" } } },
    { "tool": "bake_lighting", "args": { "quality": "preview", "texel_size": 16 } },
    { "tool": "map_file", "args": { "op": "save", "path": "${save_dir}/baked.gtm" } }
  ]
}
