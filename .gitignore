/target
/.tools
*.autosave.gtm
*.autosave.gtm.import
*.gtm.autosave
*.gtm.bak*
godot/.godot/
# FuncGodot writes generated materials next to textures on build.
godot/demo/textures/base/*.tres
# The nature trees are .glb with their textures embedded. Godot's glTF importer extracts those next to the
# model on import, so the sibling images and every .import here are regenerated, never authored.
godot/godottrench/nature/trees/*.png
godot/godottrench/nature/trees/*.png.import
godot/godottrench/nature/trees/*.glb.import
/.worktrees
__pycache__/

# Emergent tooling, not part of the project
.emergent/
plan.md
