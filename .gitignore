godot/.godot/
# The generated nature trees and bushes share the images in nature/textures. Godot writes the .import
# files for them on the first import, they are regenerated, never authored.
godot/trenchdot/nature/trees/*.import
godot/trenchdot/nature/trees_detailed/*.import
godot/trenchdot/nature/bushes/*.import
godot/trenchdot/nature/textures/*.import
/.worktrees
__pycache__/

# Emergent tooling, not part of the project
.emergent/
plan.md

# Docs site output and the Python environment that builds it. Zensical's .cache/ ignores itself.
/_site/
/.venv/
