#!/bin/sh
# Formats staged Rust before every commit so the tree never drifts from rustfmt.toml, whoever (or whatever) wrote
# the change. Enable it once per clone with `tools/fmt --install`.
set -eu

staged=$(git diff --cached --name-only --diff-filter=ACM -- '*.rs')
[ -z "$staged" ] && exit 0

cargo fmt --all

# Re-stage the Rust files that were already part of this commit so their formatting is included.
printf '%s\n' "$staged" | tr '\n' '\0' | xargs -0 git add --
