{
  "name": "Built-in",
  "units_per_meter": 32.0,
  "entities": [
    {
      "classname": "worldspawn", "type": "solid", "description": "The map itself. Sky, fog and sun keys build a WorldEnvironment in Godot.", "color": "#ffffffff",
      "properties": [
        { "name": "message", "type": "string", "description": "Map title" },
        { "name": "sun_angles", "type": "string", "default": "-40 -60", "description": "Sun pitch and yaw in degrees" },
        { "name": "sun_color", "type": "color", "default": "255 244 225", "description": "Sun color" },
        { "name": "sun_energy", "type": "float", "default": "1.0", "description": "Sun brightness" },
        { "name": "ambient_color", "type": "color", "default": "70 80 100", "description": "Ambient light" },
        { "name": "sky_top_color", "type": "color", "default": "80 128 196", "description": "Sky zenith" },
        { "name": "sky_horizon_color", "type": "color", "default": "196 210 224", "description": "Sky horizon" },
        { "name": "sky_ground_color", "type": "color", "default": "100 104 108", "description": "Below the horizon" },
        { "name": "fog_color", "type": "color", "default": "190 204 218", "description": "Fog color" },
        { "name": "fog_density", "type": "float", "default": "0", "description": "Fog density per meter, 0 disables fog" },
        { "name": "environment", "type": "bool", "default": "1", "description": "Build the WorldEnvironment and sun in Godot" },
        { "name": "chunk_streaming", "type": "bool", "default": "0", "description": "Group the built map into chunks and only draw the ones near the camera" },
        { "name": "chunk_size", "type": "float", "default": "2048", "description": "Size of a streaming chunk in map units" },
        { "name": "load_radius", "type": "float", "default": "8192", "description": "Distance from the camera a chunk stays drawn within, in map units" }
      ]
    },
    {
      "classname": "info_player_start", "type": "point", "description": "Player spawn point", "color": "#33ff33ff", "node_class": "Marker3D",
      "size": [[-16, 0, -16], [16, 56, 16]], "properties": []
    },
    {
      "classname": "info_teleport_destination", "type": "point", "description": "Where trigger_teleport sends bodies. Its yaw becomes their facing.", "color": "#66ddffff", "node_class": "Marker3D",
      "size": [[-16, 0, -16], [16, 56, 16]],
      "properties": [{ "name": "targetname", "type": "target_source", "description": "Name trigger_teleport refers to" }]
    },
    {
      "classname": "path_corner", "type": "point", "description": "One stop of a func_train path. target names the next corner.", "color": "#aaccffff", "node_class": "Marker3D",
      "script": "res://addons/func_godot/src/godottrench/entities/gt_path_corner.gd",
      "properties": [
        { "name": "targetname", "type": "target_source", "description": "Name of this corner" },
        { "name": "target", "type": "target_destination", "description": "Next corner" },
        { "name": "wait", "type": "float", "default": "0", "description": "Seconds the train waits here" },
        { "name": "speed", "type": "float", "default": "0", "description": "New train speed in m/s from here on, 0 keeps it" }
      ],
      "outputs": [{ "name": "reached", "parameter": "train", "description": "A train arrived here" }]
    },
    {
      "classname": "light", "type": "point", "description": "Switchable omni light", "color": "#ffe64dff", "node_class": "OmniLight3D",
      "script": "res://addons/func_godot/src/godottrench/entities/gt_light.gd",
      "properties": [
        { "name": "targetname", "type": "target_source", "description": "Name" },
        { "name": "light_energy", "type": "float", "default": "1.0", "description": "Brightness" },
        { "name": "light_color", "type": "color", "default": "255 255 255", "description": "Color" },
        { "name": "omni_range", "type": "float", "default": "10.0", "description": "Range in meters" },
        { "name": "start_on", "type": "bool", "default": "1", "description": "Starts switched on" }
      ],
      "inputs": [{ "name": "turn_on" }, { "name": "turn_off" }, { "name": "toggle" }],
      "outputs": [{ "name": "switched", "parameter": "on" }]
    },
    {
      "classname": "prop_model", "type": "point", "description": "Model prop (.bbmodel, .glb, .gltf, .tscn) with optional collision", "color": "#8cd973ff", "node_class": "Node3D",
      "script": "res://addons/func_godot/src/godottrench/runtime/godottrench_prop.gd",
      "size": [[-16, 0, -16], [16, 32, 16]],
      "properties": [
        { "name": "model", "type": "resource", "description": "res:// path of the model" },
        { "name": "collision", "type": "choices", "default": "convex", "description": "Collision shape", "options": [["none", "none"], ["convex", "convex"], ["trimesh", "trimesh"]] },
        { "name": "scale", "type": "float", "default": "1.0", "description": "Uniform scale" }
      ]
    },
    { "classname": "func_detail", "type": "solid", "description": "Detail brushes", "color": "#99cc99ff", "node_class": "StaticBody3D", "properties": [] },
    { "classname": "func_geo", "type": "solid", "description": "Geometry without collision", "color": "#9999e6ff", "node_class": "Node3D", "properties": [] },
    { "classname": "func_illusionary", "type": "solid", "description": "Visible geometry without collision", "color": "#b3b3ffff", "node_class": "Node3D", "properties": [] },
    {
      "classname": "func_door", "type": "solid", "description": "Sliding door. Moves by travel when opened, back when closed.", "color": "#4db3ffff", "node_class": "AnimatableBody3D",
      "script": "res://addons/func_godot/src/godottrench/entities/gt_door.gd",
      "properties": [
        { "name": "targetname", "type": "target_source", "description": "Name other entities use to open it" },
        { "name": "travel", "type": "vector3", "default": "0 64 0", "description": "Offset the door slides by, in map units" },
        { "name": "speed", "type": "float", "default": "2.0", "description": "Meters per second" },
        { "name": "wait", "type": "float", "default": "-1", "description": "Seconds before it closes again, -1 stays open" },
        { "name": "locked", "type": "bool", "default": "0", "description": "Ignores open and use until unlocked" },
        { "name": "start_open", "type": "bool", "default": "0", "description": "Starts in the open position" },
        { "name": "interact", "type": "bool", "default": "1", "description": "Opens when a player calls use() on it" }
      ],
      "outputs": [{ "name": "opened" }, { "name": "closed" }, { "name": "started_opening" }, { "name": "started_closing" }, { "name": "locked_use", "parameter": "activator" }],
      "inputs": [{ "name": "open" }, { "name": "close" }, { "name": "toggle" }, { "name": "lock" }, { "name": "unlock" }, { "name": "use", "parameter": "activator" }],
      "gizmos": [{ "type": "travel", "property": "travel" }]
    },
    {
      "classname": "func_door_rotating", "type": "solid", "description": "Door or gate swinging around a hinge. Drag the hinge handle in the viewport.", "color": "#d99a4dff", "node_class": "AnimatableBody3D",
      "script": "res://addons/func_godot/src/godottrench/entities/gt_door_rotating.gd",
      "properties": [
        { "name": "targetname", "type": "target_source", "description": "Name other entities use to open it" },
        { "name": "hinge", "type": "vector3", "default": "0 0 0", "description": "Hinge position relative to the door center, map units" },
        { "name": "axis", "type": "choices", "default": "y", "description": "Hinge axis", "options": [["vertical (y)", "y"], ["x", "x"], ["z", "z"]] },
        { "name": "open_angle", "type": "float", "default": "95", "description": "Degrees to swing, negative swings the other way" },
        { "name": "speed", "type": "float", "default": "120", "description": "Degrees per second" },
        { "name": "open_away", "type": "bool", "default": "1", "description": "Swings away from whoever opens it" },
        { "name": "wait", "type": "float", "default": "-1", "description": "Seconds before it closes again, -1 stays open" },
        { "name": "locked", "type": "bool", "default": "0", "description": "Ignores open and use until unlocked" },
        { "name": "start_open", "type": "bool", "default": "0", "description": "Starts open" },
        { "name": "interact", "type": "bool", "default": "1", "description": "Opens when a player calls use() on it" }
      ],
      "outputs": [{ "name": "opened" }, { "name": "closed" }, { "name": "started_opening" }, { "name": "started_closing" }, { "name": "locked_use", "parameter": "activator" }],
      "inputs": [{ "name": "open", "parameter": "activator" }, { "name": "close" }, { "name": "toggle", "parameter": "activator" }, { "name": "lock" }, { "name": "unlock" }, { "name": "use", "parameter": "activator" }],
      "gizmos": [{ "type": "hinge", "property": "hinge", "angle": "open_angle", "axis": "axis" }]
    },
    {
      "classname": "func_gate", "type": "solid", "description": "Alias of func_door_rotating kept for older maps", "color": "#d99a4dff", "node_class": "AnimatableBody3D",
      "script": "res://addons/func_godot/src/godottrench/entities/gt_door_rotating.gd",
      "properties": [
        { "name": "targetname", "type": "target_source", "description": "Name" },
        { "name": "hinge", "type": "vector3", "default": "0 0 0", "description": "Hinge position relative to the leaf center, map units" },
        { "name": "open_angle", "type": "float", "default": "100", "description": "Degrees to swing" },
        { "name": "speed", "type": "float", "default": "90", "description": "Degrees per second" }
      ],
      "outputs": [{ "name": "opened" }, { "name": "closed" }],
      "inputs": [{ "name": "open" }, { "name": "close" }, { "name": "toggle" }],
      "gizmos": [{ "type": "hinge", "property": "hinge", "angle": "open_angle" }]
    },
    {
      "classname": "func_platform", "type": "solid", "description": "Lift or moving platform travelling between its start and start + travel. Riders move with it.", "color": "#66ccb3ff", "node_class": "AnimatableBody3D",
      "script": "res://addons/func_godot/src/godottrench/entities/gt_platform.gd",
      "properties": [
        { "name": "targetname", "type": "target_source", "description": "Name" },
        { "name": "travel", "type": "vector3", "default": "0 128 0", "description": "Offset to the end position, map units" },
        { "name": "speed", "type": "float", "default": "2.0", "description": "Meters per second" },
        { "name": "wait", "type": "float", "default": "1.0", "description": "Seconds spent at each end" },
        { "name": "mode", "type": "choices", "default": "0", "description": "toggle moves on input, ping pong loops, once goes to the end", "options": [["toggle", "0"], ["ping pong", "1"], ["once", "2"]] },
        { "name": "start_active", "type": "bool", "default": "0", "description": "Starts moving on map load" }
      ],
      "outputs": [{ "name": "reached_end" }, { "name": "reached_start" }, { "name": "started" }],
      "inputs": [{ "name": "start" }, { "name": "stop" }, { "name": "toggle" }, { "name": "go_to_end" }, { "name": "go_to_start" }],
      "gizmos": [{ "type": "travel", "property": "travel" }]
    },
    {
      "classname": "func_train", "type": "solid", "description": "Moves along a chain of path_corner entities", "color": "#80b3ffff", "node_class": "AnimatableBody3D",
      "script": "res://addons/func_godot/src/godottrench/entities/gt_train.gd",
      "properties": [
        { "name": "targetname", "type": "target_source", "description": "Name" },
        { "name": "target", "type": "target_destination", "description": "First path_corner" },
        { "name": "speed", "type": "float", "default": "3.0", "description": "Meters per second" },
        { "name": "loop", "type": "bool", "default": "1", "description": "Returns to the first corner after the last" },
        { "name": "start_active", "type": "bool", "default": "1", "description": "Starts moving on map load" },
        { "name": "orient", "type": "bool", "default": "0", "description": "Turns to face its direction of travel" }
      ],
      "outputs": [{ "name": "arrived", "parameter": "corner" }, { "name": "finished" }],
      "inputs": [{ "name": "start" }, { "name": "stop" }, { "name": "toggle" }]
    },
    {
      "classname": "func_button", "type": "solid", "description": "Pressable button. Moves by travel while pressed and fires pressed.", "color": "#ff8033ff", "node_class": "AnimatableBody3D",
      "script": "res://addons/func_godot/src/godottrench/entities/gt_button.gd",
      "properties": [
        { "name": "targetname", "type": "target_source", "description": "Name" },
        { "name": "travel", "type": "vector3", "default": "0 -2 0", "description": "Press movement in map units" },
        { "name": "wait", "type": "float", "default": "1.0", "description": "Seconds before it pops out again, -1 stays pressed" },
        { "name": "locked", "type": "bool", "default": "0", "description": "Fires locked_use instead of pressed" },
        { "name": "interact", "type": "bool", "default": "1", "description": "Pressed when a player calls use() on it" }
      ],
      "outputs": [{ "name": "pressed", "parameter": "activator" }, { "name": "released" }, { "name": "locked_use", "parameter": "activator" }],
      "inputs": [{ "name": "press", "parameter": "activator" }, { "name": "release" }, { "name": "lock" }, { "name": "unlock" }, { "name": "use", "parameter": "activator" }],
      "gizmos": [{ "type": "travel", "property": "travel" }]
    },
    {
      "classname": "trigger_area", "type": "solid", "description": "Plain Area3D volume firing body_entered and body_exited", "color": "#e6991aff", "node_class": "Area3D",
      "properties": [{ "name": "targetname", "type": "target_source", "description": "Name" }],
      "outputs": [{ "name": "body_entered", "parameter": "body" }, { "name": "body_exited", "parameter": "body" }]
    },
    {
      "classname": "trigger_once", "type": "solid", "description": "Fires triggered the first time a body of filter_group enters, then disables itself", "color": "#e6991aff", "node_class": "Area3D",
      "script": "res://addons/func_godot/src/godottrench/entities/gt_trigger.gd",
      "properties": [
        { "name": "targetname", "type": "target_source", "description": "Name" },
        { "name": "filter_group", "type": "string", "default": "player", "description": "Only bodies in this group, empty accepts any body" },
        { "name": "start_disabled", "type": "bool", "default": "0", "description": "Needs an enable input first" },
        { "name": "once", "type": "bool", "default": "1", "description": "Disables itself after firing" }
      ],
      "outputs": [{ "name": "triggered", "parameter": "activator" }, { "name": "entered", "parameter": "activator" }, { "name": "exited", "parameter": "activator" }],
      "inputs": [{ "name": "enable" }, { "name": "disable" }, { "name": "toggle" }]
    },
    {
      "classname": "trigger_multiple", "type": "solid", "description": "Fires triggered every time a body of filter_group enters, at most once per cooldown", "color": "#e6991aff", "node_class": "Area3D",
      "script": "res://addons/func_godot/src/godottrench/entities/gt_trigger.gd",
      "properties": [
        { "name": "targetname", "type": "target_source", "description": "Name" },
        { "name": "filter_group", "type": "string", "default": "player", "description": "Only bodies in this group, empty accepts any body" },
        { "name": "cooldown", "type": "float", "default": "0.5", "description": "Seconds between firings" },
        { "name": "start_disabled", "type": "bool", "default": "0", "description": "Needs an enable input first" }
      ],
      "outputs": [{ "name": "triggered", "parameter": "activator" }, { "name": "entered", "parameter": "activator" }, { "name": "exited", "parameter": "activator" }],
      "inputs": [{ "name": "enable" }, { "name": "disable" }, { "name": "toggle" }]
    },
    {
      "classname": "trigger_call", "type": "solid", "description": "Calls a method in your game code (GDScript or C#) when a body enters. call_target is a node path like /root/Game, @group, a targetname or !activator.", "color": "#f2c233ff", "node_class": "Area3D",
      "script": "res://addons/func_godot/src/godottrench/entities/gt_trigger_call.gd",
      "properties": [
        { "name": "targetname", "type": "target_source", "description": "Name" },
        { "name": "filter_group", "type": "string", "default": "player", "description": "Only bodies in this group, empty accepts any body" },
        { "name": "call_target", "type": "string", "default": "!activator", "description": "Node path (/root/Game), @group, targetname, !activator or !self" },
        { "name": "method", "type": "string", "default": "", "description": "Method to call, C# PascalCase names work too" },
        { "name": "arguments", "type": "string", "default": "[]", "description": "JSON array. $activator, $self and $position are replaced" },
        { "name": "once", "type": "bool", "default": "0", "description": "Only calls the first time" },
        { "name": "cooldown", "type": "float", "default": "0.5", "description": "Seconds between calls" }
      ],
      "outputs": [{ "name": "called", "parameter": "result" }, { "name": "triggered", "parameter": "activator" }],
      "inputs": [{ "name": "trigger", "parameter": "activator" }, { "name": "enable" }, { "name": "disable" }]
    },
    {
      "classname": "trigger_spawn_area", "type": "solid", "description": "Spawns scenes at random spots inside its volume, when a body of filter_group enters or on input", "color": "#e64d4dff", "node_class": "Area3D",
      "script": "res://addons/func_godot/src/godottrench/entities/gt_spawn_area.gd",
      "properties": [
        { "name": "targetname", "type": "target_source", "description": "Name" },
        { "name": "scene", "type": "resource", "description": "res:// scene to spawn (enemy, pickup, prop)" },
        { "name": "count", "type": "int", "default": "3", "description": "Instances per spawn" },
        { "name": "max_alive", "type": "int", "default": "10", "description": "Never more alive at once" },
        { "name": "total", "type": "int", "default": "0", "description": "Stops after this many, 0 is unlimited" },
        { "name": "interval", "type": "float", "default": "0", "description": "Seconds between spawns while active, 0 spawns only on events" },
        { "name": "spawn_on_enter", "type": "bool", "default": "1", "description": "Spawns when a body of filter_group enters" },
        { "name": "filter_group", "type": "string", "default": "player", "description": "Group that activates the area" },
        { "name": "spawn_group", "type": "string", "default": "enemies", "description": "Group added to spawned nodes" },
        { "name": "snap_to_ground", "type": "bool", "default": "1", "description": "Drops spawns onto the floor below" }
      ],
      "outputs": [{ "name": "spawned", "parameter": "node" }, { "name": "all_dead" }, { "name": "exhausted" }],
      "inputs": [{ "name": "spawn" }, { "name": "start" }, { "name": "stop" }, { "name": "toggle" }, { "name": "kill_all" }]
    },
    {
      "classname": "trigger_hurt", "type": "solid", "description": "Damages bodies inside by calling their damage method", "color": "#ff3333ff", "node_class": "Area3D",
      "script": "res://addons/func_godot/src/godottrench/entities/gt_hurt.gd",
      "properties": [
        { "name": "targetname", "type": "target_source", "description": "Name" },
        { "name": "damage", "type": "float", "default": "10", "description": "Damage per second" },
        { "name": "damage_method", "type": "string", "default": "take_damage", "description": "Method called on the body with (amount, source)" },
        { "name": "interval", "type": "float", "default": "0.5", "description": "Seconds between damage ticks" },
        { "name": "filter_group", "type": "string", "default": "", "description": "Only bodies in this group, empty hurts any body" }
      ],
      "outputs": [{ "name": "hurt", "parameter": "activator" }],
      "inputs": [{ "name": "enable" }, { "name": "disable" }, { "name": "toggle" }]
    },
    {
      "classname": "trigger_teleport", "type": "solid", "description": "Moves bodies to its destination entity", "color": "#66ddffff", "node_class": "Area3D",
      "script": "res://addons/func_godot/src/godottrench/entities/gt_teleport.gd",
      "properties": [
        { "name": "targetname", "type": "target_source", "description": "Name" },
        { "name": "destination", "type": "target_destination", "description": "info_teleport_destination or any named entity" },
        { "name": "filter_group", "type": "string", "default": "player", "description": "Only bodies in this group" },
        { "name": "keep_velocity", "type": "bool", "default": "0", "description": "Keeps the body's velocity" }
      ],
      "outputs": [{ "name": "teleported", "parameter": "activator" }],
      "inputs": [{ "name": "enable" }, { "name": "disable" }, { "name": "toggle" }]
    },
    {
      "classname": "trigger_push", "type": "solid", "description": "Pushes bodies: jump pads, wind, conveyors", "color": "#99e6ffff", "node_class": "Area3D",
      "script": "res://addons/func_godot/src/godottrench/entities/gt_push.gd",
      "properties": [
        { "name": "targetname", "type": "target_source", "description": "Name" },
        { "name": "push", "type": "vector3", "default": "0 384 0", "description": "Velocity in map units per second" },
        { "name": "filter_group", "type": "string", "default": "", "description": "Only bodies in this group" },
        { "name": "once", "type": "bool", "default": "1", "description": "One impulse on entering instead of a steady push" }
      ],
      "outputs": [{ "name": "pushed", "parameter": "activator" }],
      "inputs": [{ "name": "enable" }, { "name": "disable" }, { "name": "toggle" }],
      "gizmos": [{ "type": "travel", "property": "push" }]
    },
    {
      "classname": "info_spawner", "type": "point", "description": "Spawns scenes (enemies, pickups) around itself on input or on a timer", "color": "#e64d4dff", "node_class": "Node3D",
      "script": "res://addons/func_godot/src/godottrench/entities/gt_spawner.gd",
      "size": [[-16, 0, -16], [16, 48, 16]],
      "properties": [
        { "name": "targetname", "type": "target_source", "description": "Name" },
        { "name": "scene", "type": "resource", "description": "res:// scene to spawn" },
        { "name": "count", "type": "int", "default": "1", "description": "Instances per spawn" },
        { "name": "max_alive", "type": "int", "default": "5", "description": "Never more alive at once" },
        { "name": "total", "type": "int", "default": "0", "description": "Stops after this many, 0 is unlimited" },
        { "name": "interval", "type": "float", "default": "0", "description": "Seconds between spawns while active, 0 spawns only on input" },
        { "name": "radius", "type": "float", "default": "64", "description": "Random spread around the spawner, map units" },
        { "name": "start_active", "type": "bool", "default": "0", "description": "Timer runs from map load" },
        { "name": "spawn_on_ready", "type": "bool", "default": "0", "description": "Spawns once when the map loads" },
        { "name": "spawn_group", "type": "string", "default": "enemies", "description": "Group added to spawned nodes" },
        { "name": "snap_to_ground", "type": "bool", "default": "1", "description": "Drops spawns onto the floor below" }
      ],
      "outputs": [{ "name": "spawned", "parameter": "node" }, { "name": "all_dead" }, { "name": "exhausted" }],
      "inputs": [{ "name": "spawn" }, { "name": "start" }, { "name": "stop" }, { "name": "toggle" }, { "name": "kill_all" }],
      "gizmos": [{ "type": "radius", "property": "radius" }]
    },
    {
      "classname": "logic_call", "type": "point", "description": "Calls a method in your game code (GDScript or C#) when its trigger input fires", "color": "#f2c233ff", "node_class": "Node3D",
      "script": "res://addons/func_godot/src/godottrench/entities/gt_logic_call.gd",
