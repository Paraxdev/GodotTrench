      "classname": "worldspawn",
      "type": "solid",
      "description": "Default static world geometry. Builds a StaticBody3D with a single MeshInstance3D and a single convex CollisionShape3D shape.",
      "color": "#ccccccff",
      "node_class": "StaticBody3D",
      "group": "worldspawn",
      "size": [
        [
          -8.0,
          -8.0,
          -8.0
        ],
        [
          8.0,
          8.0,
          8.0
        ]
      ],
      "properties": [
        {
          "name": "_vertex_merge_distance",
          "type": "float",
          "default": "0.03125",
          "description": "Adjustable value to snap vertices to on map build. This can reduce instances of seams between polygons."
        },
        {
          "name": "_cull_interior_faces",
          "type": "bool",
          "default": "0",
          "description": "If true, cull interior faces with matching vertices or faces that are flush within a larger face. Note: This has a performance impact that scales with how many brushes are in the brush entity."
        }
      ],
      "outputs": [
        {
          "name": "input_event",
          "parameter": "camera, event, event_position, normal, shape_idx"
        },
        {
          "name": "mouse_entered",
          "parameter": ""
