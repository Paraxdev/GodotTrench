{
  "title": "TrenchDot",
  "description": "A brush based level editor for Godot",
  "language": "en",
  "plugins": [
    "-sharing",
    "-livereload",
    "-fontsettings",
    "gdscript",
    "honkit-plugin-theme-darkening"
  ],
  "pluginsConfig": {
    "theme-default": {
      "showLevel": false
    }
  },
  "links": {
    "sidebar": {
      "TrenchDot on GitHub": "https://github.com/Paraxdev/TrenchDot"
    }
  },
  "styles": {
    "website": "styles/website.css"
  }
}
